  "findings": [
    {
      "id": "FVA-01",
      "priority": "高",
      "categories": [
        3
      ],
      "title": "窄屏特殊关面板与原小地图按钮重叠",
      "finding": "844×390 资源关中，标题位于 y=144–165，工具按钮位于 y=147.25–191.25；标题中心的顶层元素实际为“生产管理”按钮，规则入口也被压住。390×844 亦见重叠。1440×900、1280×720 未见同一遮挡。",
      "impact": "玩家读不到关卡名称、剩余时间，规则入口与原操作区域冲突。",
      "repro": "进入资源关，切到 844×390 或 390×844，观察左上角状态面板与小地图工具行。",
      "recommendation": "将特殊状态纳入原 HUD 的安全区域和自适应布局；先修遮挡，再统一面板皮肤。",
      "sources": [
        "src/ui/hud/special-stages.css:1",
        "src/ui/hud/special-stages.css:8",
        "src/ui/native-hud/battle.css:40"
