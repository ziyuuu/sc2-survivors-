  const frame=stats(raw.frames),assessment=validity({seconds:raw.seconds,targetSeconds:seconds,frames:raw.frames,frameOffsets:raw.frameOffsets,longTasks:raw.longTasks,cpuWork:[],visibility:raw.visibility,focused:raw.focused,contextLost:gpu.contextLost,errors:errors.length,gpuSupported:false,gpuDisjoint:0,gpuSamples:0,pendingAssets:raw.after.assetsPending,live:true,unchanged:true,phaseComplete:raw.after.phase==='battle'}),reasons=assessment.reasons;
