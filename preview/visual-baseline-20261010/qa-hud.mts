   const observe=(now:number)=>{if(p.active){if(p.last){p.frames.push(now-p.last);p.frameOffsets.push(now-p.start);}p.last=now;p.visibility.push(document.visibilityState);p.focused.push(document.hasFocus());if(now-p.start>=seconds*1000){p.active=false;p.done=true;p.seconds=(now-p.start)/1000;p.after=w.__SC2_REPORT__();p.endHeap=(performance as any).memory?.usedJSHeapSize??null;}}if(!p.done)requestAnimationFrame(observe);};requestAnimationFrame(observe);
  },{seconds});
