import fs from 'node:fs/promises';import assert from 'node:assert/strict';import {EventCollector} from './events';import {densityGroups} from './catalog';import {scenario,prepareTargets} from './scenario';import {checksum,encodeGraph} from '../../src/persistence/graph-codec';
const rows=[];for(const group of densityGroups.filter(g=>g.density===48)){const s=scenario(group),w=s.world,c=new EventCollector(),expected=new Map<number,any>(),kinds=new Map<number,Set<string>>();prepareTargets(s);w.paused=false;const initial=structuredClone(w.captureRun());for(let tick=0;tick<600;tick++){w.step();const before=tick%60===0?checksum(JSON.stringify(encodeGraph(w.captureRun()))):null;for(const e of w.visualEvents){expected.set(e.serial,e);const set=kinds.get(e.entityId)??new Set<string>();set.add(e.kind);kinds.set(e.entityId,set);}c.record(w.visualEvents);if(before!==null)assert.equal(checksum(JSON.stringify(encodeGraph(w.captureRun()))),before);if(tick%60===0)assert.deepEqual(c.history,[...expected.values()].slice(-10000));}for(const [id,set] of kinds)assert.deepEqual(c.kinds.get(id),set);const total=expected.size;c.reset();w.restoreRun(initial);w.paused=false;w.step();c.record(w.visualEvents);assert.equal(c.lastSerial,w.visualEvents.at(-1)?.serial??0);rows.push({group:group.id,events:total,kinds:kinds.size,stateReadOnly:true,ringAndReset:true});}
await fs.writeFile('D:/星际/reports/local/visual-plan-validation-20261009/event-collector-validation.json',JSON.stringify({rows},null,2));console.log(JSON.stringify(rows));