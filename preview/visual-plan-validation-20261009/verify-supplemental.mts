import fs from 'node:fs/promises';import assert from 'node:assert/strict';import {densityGroups,actorGroups,enemyGroups} from './catalog';import {scenario,prepareTargets,resolveActors,destroyActors} from './scenario';import {World} from '../../src/simulation/world';import {checksum,encodeGraph} from '../../src/persistence/graph-codec';
