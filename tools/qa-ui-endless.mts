 await page.reload({timeout:240000});await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu',null,{timeout:240000});await page.locator('[data-action=menu-load]').click();await page.locator('[data-action=menu-load-local]').click();await page.locator('[data-action=menu-load-ready]').click();await ready();await page.locator('[data-action=flow-continue]').click();assert.equal(key(await exported()),key(saved));report.checks.push('public ready commit enters original endless map and exact save state survives reload');assert.deepEqual(report.errors,[]);report.passed=true;
