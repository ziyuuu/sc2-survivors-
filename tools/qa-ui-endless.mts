 await back();assert.equal(await page.locator('[data-ui-route=catalog]').count(),1);await back();assert.equal(await page.locator('[data-ui-route=root]').count(),1);await shot('preparation');await back();assert.equal(await page.locator('[data-action=endless]').count(),1);report.checks.push('virtual gamepad B pops catalogue detail, catalogue and endless preparation one level at a time');
