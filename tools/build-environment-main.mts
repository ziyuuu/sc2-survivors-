import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {build} from 'vite';
const diagnostic=process.argv.includes('--diagnostic'),output=process.argv.find(a=>a.startsWith('--out='))?.slice(6)??(diagnostic?'reports/local/mvp5-full-map-20261014/main-diagnostic-r1':'dist/MVP5-Full-Map-Main-20261014-R1');
if(output.includes('..')||!['reports/local/mvp5-full-map-20261014/','dist/MVP5-Full-Map-Main-20261014-'].some(p=>output.startsWith(p)))throw Error('Unsafe output');
await fs.access(output).then(()=>{throw Error('Output exists');},e=>{if(e.code!=='ENOENT')throw e;});
const sha=(b:Buffer|string)=>createHash('sha256').update(b).digest('hex'),sourceRoot=process.cwd(),inputs=new Map<string,{file:string;bytes:number;sha256:string}>();
await build({root:sourceRoot,configFile:false,publicDir:false,base:'./',build:{outDir:path.resolve(output),emptyOutDir:false,target:'es2022',sourcemap:false},plugins:[{name:'approved-opening',async transformIndexHtml(html){return html.replace('<!--SC2_OPENING-->',await fs.readFile('src/ui/presentation/opening.generated.html','utf8'));}},{name:'full-map-input-binding',enforce:'pre',async transform(source,id){
 const file=id.split('?')[0],relative=path.relative(sourceRoot,file).replaceAll('\\','/');if(relative.startsWith('..')||path.isAbsolute(relative)||relative.includes('node_modules/')||relative.startsWith('\0'))return;
 const bytes=await fs.readFile(file).catch(()=>null);if(bytes)inputs.set(relative,{file:relative,bytes:bytes.length,sha256:sha(bytes)});
 if(diagnostic&&relative==='src/app/bootstrap.ts'){const marker='window.__SC2_REPORT__=()=>';assert.equal(source.split(marker).length,2);return {code:source.replace(marker,'(window as any).__MVP5_NATIVE__=(window as any).__MVP1_NATIVE__={world,view,hud,session,readiness,background,controls,driver};'+marker),map:null};}
}}]});
const previous=JSON.parse(await fs.readFile('deploy/coze/public/web-release.json','utf8')),old=JSON.parse(await fs.readFile('deploy/coze/public/'+previous.manifest,'utf8'));
const closure=JSON.parse(await fs.readFile('reports/local/asset-reachability.json','utf8')),assets:Record<string,any>={},files=new Map<string,any>();
const mime:Record<string,string>={'.gltf':'model/gltf+json','.glb':'model/gltf-binary','.png':'image/png','.webp':'image/webp','.jpg':'image/jpeg','.ogg':'audio/ogg','.mp3':'audio/mpeg','.wav':'audio/wav','.json':'application/json','.svg':'image/svg+xml'};
for(const row of closure.rows){const url='assets/'+row.sha256+path.extname(row.packedFile),gitFile='deploy/runtime/'+url,bytes=await fs.readFile(gitFile);assert.equal(sha(bytes),row.sha256);assert.equal(bytes.length,row.bytes);assets[row.id]={url,bytes:row.bytes,sha256:row.sha256,mime:mime[path.extname(url)]??'application/octet-stream'};files.set(url,assets[row.id]);}
for(const [id,r] of Object.entries(old.assets) as [string,any][]){assert.ok(assets[id],'Previously shipped asset removed: '+id);assert.equal(assets[id].sha256,r.sha256,'Original asset changed: '+id);}
const release=sha(JSON.stringify(assets)),manifest='asset-manifest.'+release+'.json';await fs.writeFile(output+'/'+manifest,JSON.stringify({version:1,release,assets}));
const builtFiles:{file:string;bytes:number;sha256:string}[]=[];
async function collect(dir:string){for(const e of await fs.readdir(dir,{withFileTypes:true})){const full=path.join(dir,e.name);if(e.isDirectory())await collect(full);else{const bytes=await fs.readFile(full);builtFiles.push({file:path.relative(output,full).replaceAll('\\','/'),bytes:bytes.length,sha256:sha(bytes)});}}}
await collect(output);builtFiles.sort((a,b)=>a.file.localeCompare(b.file));const appBuildId=sha(JSON.stringify(builtFiles));
let index=await fs.readFile(output+'/index.html','utf8');index=index.replace('<head>',`<head><meta name="sc2-app-build" content="${appBuildId}"><meta name="sc2-asset-manifest" content="./${manifest}">`);await fs.writeFile(output+'/index.html',index);await fs.writeFile(output+'/runtime-config.json',JSON.stringify({assetBaseUrl:''}));
const assetBytes=[...files.values()].reduce((n,r)=>n+r.bytes,0),logicalBytes=Object.values(assets).reduce((n,r)=>n+r.bytes,0);
const webRelease={...previous,appBuildId,release,manifest,assetCount:Object.keys(assets).length,fileCount:files.size,assetBytes,logicalBytes,sharedBytes:logicalBytes-assetBytes,diagnostic,review:true,source:'MVP5 full-map steps 1 and 2 with verified new-run building integration'};
await fs.writeFile(output+'/web-release.json',JSON.stringify(webRelease,null,2));builtFiles.length=0;await collect(output);builtFiles.sort((a,b)=>a.file.localeCompare(b.file));
const report={at:new Date().toISOString(),output,sourceRoot,appBuildId,diagnostic,inputs:[...inputs.values()].sort((a,b)=>a.file.localeCompare(b.file)),builtFiles,resources:{release,records:Object.keys(assets).length,files:files.size,oldRetained:Object.keys(old.assets).length,newIds:Object.keys(assets).filter(id=>!old.assets[id]),assetRoot:'deploy/runtime'}};
await fs.writeFile(output+'/build-inputs.json',JSON.stringify(report,null,2));console.log(JSON.stringify({output,appBuildId,diagnostic,inputs:inputs.size,resources:report.resources}));
