const mode=process.argv[2]??'web';assert.ok(['web','offline','application'].includes(mode));
const root=path.resolve('.cache/v04-20261027/browser-'+mode+(process.argv[3]?'-'+process.argv[3]:'')),profile=root+'/profile',html=path.resolve('dist/SC2-Survivors-V04-20261027.html');await fs.mkdir(root,{recursive:true});
const web=path.resolve('dist/web'),app=path.resolve('dist/V04-20261027/Application');
const createServer=mode==='application'?(await import(pathToFileURL(app+'/coze-web-server.mjs').href)).createGameServer:createGameServer;
const server=mode==='offline'?null:createServer({webRoot:mode==='application'?app+'/public':web,assetRoot:web,backendOptions:{config:{enabled:false}}});
if(server)await new Promise<void>(r=>server.listen(Number(process.argv.find(x=>x.startsWith('--port='))?.slice(7)??0),'127.0.0.1',r));
const entry=server?'http://127.0.0.1:'+server.address().port:pathToFileURL(html).href;
const continuing=process.argv.includes('--continue-intermissions');
const previous=continuing?JSON.parse(await fs.readFile(root+'/result.json','utf8')):null;
const report:any={mode,entry,checks:previous?.checks??[],screens:previous?.screens??[],newGame:previous?.newGame,errors:[],httpErrors:[],externalRequests:[],complete:false,...(continuing?{continuedAfterFixtureCorrection:true}: {})};let browser:Browser,child:ReturnType<typeof spawn>,page:Page,phase='launch';
const timer=setInterval(async()=>{const readiness=await page?.evaluate(()=>(globalThis as any).__SC2_REPORT__?.().readiness).catch(()=>null);console.log(JSON.stringify({mode,phase,checks:report.checks.length,readiness}));},25000);
async function launch(){await fs.mkdir(profile,{recursive:true});child=spawn('C:/Program Files/Google/Chrome/Application/chrome.exe',['--remote-debugging-port=0','--user-data-dir='+profile,'--no-first-run','--no-default-browser-check','--disable-background-timer-throttling','--disable-renderer-backgrounding','--disable-backgrounding-occluded-windows','--disable-features=AutoDeElevate','--allow-file-access-from-files','about:blank'],{windowsHide:true,stdio:'ignore'});let port:number|undefined;for(let i=0;i<150;i++){try{port=Number((await fs.readFile(profile+'/DevToolsActivePort','utf8')).split('\n')[0]);if((await fetch('http://127.0.0.1:'+port+'/json/version')).ok)break;}catch{}await new Promise(r=>setTimeout(r,100));}
 browser=await chromium.connectOverCDP('http://127.0.0.1:'+port,{noDefaults:true});const context=browser.contexts()[0];if(mode==='offline')await context.setOffline(true);await context.addInitScript('globalThis.__name=(v)=>v;');page=context.pages()[0]??await context.newPage();page.setDefaultTimeout(120000);await page.setViewportSize({width:1440,height:900});const cdp=await context.newCDPSession(page);await cdp.send('Emulation.setFocusEmulationEnabled',{enabled:true});
 page.on('pageerror',e=>report.errors.push(e.message));page.on('console',e=>{if(e.type()==='error')report.errors.push(e.text());});page.on('response',r=>{if(r.status()>=400)report.httpErrors.push([r.status(),r.url()]);});page.on('request',r=>{if(/^https?:/.test(r.url())&&(mode==='offline'||new URL(r.url()).hostname!=='127.0.0.1'))report.externalRequests.push(r.url());});
 await page.bringToFront();await page.goto(entry,{timeout:600000});await menu();}
async function close(){if(browser){const s=await browser.newBrowserCDPSession();await s.send('Browser.close').catch(()=>{});await browser.close();}if(child?.exitCode===null)child.kill();await new Promise(r=>setTimeout(r,1500));}
const read=()=>page.evaluate(()=>(globalThis as any).__SC2_REPORT__());
const click=(action:string)=>page.locator('[data-action="'+action+'"]:visible').first().click();
async function menu(){await page.waitForFunction(()=>typeof(globalThis as any).__SC2_REPORT__==='function'&&(globalThis as any).__SC2_REPORT__().phase==='menu'&&!document.getElementById('scs-opening-visual'),null,{timeout:600000});}
async function ready(){await page.waitForFunction(()=>['ready','error'].includes((globalThis as any).__SC2_REPORT__().readiness.phase),null,{timeout:600000});const r=await read();assert.equal(r.readiness.phase,'ready',JSON.stringify(r.readiness));assert.equal(r.assetsPending,0);assert.equal(r.sourceCombat.source.missing,0);await click('flow-continue');}
async function shot(name:string){await page.screenshot({path:root+'/'+name+'.png'});report.screens.push(name);}
async function openSaves(){if(await page.locator('[data-action="save-export"]:visible').count())return;await click('settings');await page.locator('[data-action="settings-tab"][data-tab="saves"]:visible').click();}
async function exportSave(label:string){await openSaves();const downloads:any[]=[],session=await browser.newBrowserCDPSession(),folder=path.join(root,'downloads');await fs.mkdir(folder,{recursive:true});session.on('Browser.downloadWillBegin',d=>downloads.push({...d,state:'started'}));session.on('Browser.downloadProgress',d=>Object.assign(downloads.find(x=>x.guid===d.guid)??{},d));await session.send('Browser.setDownloadBehavior',{behavior:'allowAndName',downloadPath:folder,eventsEnabled:true});await click('save-export');for(let i=0;i<150&&!downloads.some(d=>d.state==='completed');i++)await page.waitForTimeout(100);const d=downloads.find(d=>d.state==='completed');assert.ok(d,'No completed export: '+JSON.stringify(downloads));const raw=await fs.readFile(folder+'/'+d.guid,'utf8'),bundle=readArchive(raw).bundle;await fs.writeFile(root+'/'+label+'.json',raw);await session.detach();return bundle;}
async function saved(){await page.waitForFunction(()=>{const s=(globalThis as any).__SC2_REPORT__().save;return !s.busy&&s.savedAt>0&&!s.message.includes('失败');});}
async function resume(){await click('save-continue');await ready();await saved();}
async function importFixture(race:string){await page.reload({timeout:600000});await menu();await openSaves();const chooser=page.waitForEvent('filechooser');await click('menu-load-file');await(await chooser).setFiles(path.resolve('.cache/v04-20261027/fixtures/'+race+'.json'));await ready();await saved();assert.equal((await read()).phase,'reward');assert.equal((await read()).stage,3);}
function sameSaved(a:SaveBundle,b:SaveBundle){assert.deepEqual(encodeGraph(b.run),encodeGraph(a.run));assert.deepEqual(encodeGraph(b.equipment),encodeGraph(a.equipment));assert.deepEqual(encodeGraph(b.management),encodeGraph(a.management));assert.deepEqual(encodeGraph(b.shopProgress),encodeGraph(a.shopProgress));}
try{
 await launch();if(!continuing){await shot('menu');assert.deepEqual(await page.evaluate(()=>['T01','__SC2_DEBUG__','__SC2_GAME__'].filter(k=>k in globalThis)),[]);report.checks.push('production-entry-without-test-control-api');
 phase='new-game';await click('menu-new');await click('menu-race-next');await click('menu-difficulty-next');await click('menu-start');await ready();await page.waitForFunction(()=>(globalThis as any).__SC2_REPORT__().time>3,null,{timeout:180000});await shot('battle-live');await page.keyboard.press('Escape');await page.waitForSelector('.pause-modal');await saved();await shot('battle');const battle=await read();assert.equal(battle.audio.originalDecoded,1921);assert.ok(battle.time>3);assert.equal(battle.phase,'battle');report.newGame={time:battle.time,stage:battle.stage,wallet:battle.wallet,race:battle.expedition.race,decoded:battle.audio.originalDecoded};report.checks.push('normal-new-game-render-and-audio-decode');
 const initial=await exportSave('new-game');assert.ok(initial.run);if(mode!=='application'){await close();phase='actual-browser-reopen';await launch();assert.equal((await read()).save.canResume,true);await resume();if(!await page.locator('.pause-modal').isVisible())await page.keyboard.press('Escape');const resumed=await exportSave('reopened');sameSaved(initial,resumed);report.checks.push('new-game-checkpoint-survives-complete-browser-close');await shot('reopened');}else report.checks.push('application-native-checkpoint-export');
 }
 for(const race of mode==='application'?[]:mode==='offline'?['terran']:['terran','zerg','protoss']){phase='intermission-'+race;let before:SaveBundle;if(continuing&&race==='terran'){assert.ok(previous.checks.includes('new-game-checkpoint-survives-complete-browser-close'));before=readArchive(await fs.readFile(root+'/terran-imported.json','utf8')).bundle;}else{await importFixture(race);before=await exportSave(race+'-imported');await click('save-now');await saved();await page.reload({timeout:600000});await menu();}assert.equal(Object.keys(before.equipment!.items).length,3);const fixture=readArchive(await fs.readFile(path.resolve('.cache/v04-20261027/fixtures/'+race+'.json'),'utf8')).bundle;assert.deepEqual(before.run!.state.wallet,fixture.run!.state.wallet);await resume();const after=await exportSave(race+'-restored');sameSaved(before,after);assert.equal(Object.keys(after.equipment!.items).length,3);report.checks.push(race+'-checkpoint-equipment-wallet-receipts-roundtrip');if(race==='terran')await shot('intermission');}
 phase='responsive';if(await page.locator('[data-action="settings-back"]:visible').count())await click('settings-back');await shot('final-view');for(const [width,height]of [[844,390],[390,844]]){await page.setViewportSize({width,height});await page.waitForTimeout(400);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),true);await shot('viewport-'+width+'x'+height);}report.checks.push('landscape-and-portrait-layout');
 assert.deepEqual(report.errors,[]);assert.deepEqual(report.httpErrors,[]);assert.deepEqual(report.externalRequests,[]);report.complete=true;
}catch(e){report.failure=String((e as Error).stack??e);process.exitCode=1;await shot('failure').catch(()=>{});report.last=await read().catch(()=>null);}finally{clearInterval(timer);await close().catch(()=>{});if(server){server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));}await fs.writeFile(root+'/result.json',JSON.stringify(report,null,2));console.log(JSON.stringify({mode,complete:report.complete,checks:report.checks,errors:report.errors,httpErrors:report.httpErrors,failure:report.failure}));}
