const all=Object.values(catalog) as any[],displacement=all.filter(m=>m.materialReferences.some((r:any)=>r.type===2)).map(m=>m.id);
const routes=source.routes.map((r:any)=>({key:r.key,family:r.family,weapon:r.weapon,kind:r.kind,mode:r.mode??null,mounts:r.key==='marauder'?['Left on odd native shot sequence','Right on even native shot sequence']:r.key==='thor-high-impact'?['01/03 on odd sequence','02/04 on even sequence']:r.mounts??['Original Weapon attachment with model fallback'],models:r.models,actors:r.actors,sourceMappings:r.sourceMappings??[],actorSources:r.actorChains.flatMap((a:any)=>a.definitions.map((d:any)=>({actor:a.id,id:d.id,file:d.file}))),adaptation:r.adaptation??null}));
