await fs.mkdir('reports/qa',{recursive:true});await fs.writeFile('reports/qa/combat-effects-sources-20261012.json',JSON.stringify(ledger,null,2)+'\n');
const esc=(v:any)=>String(v??'—').replaceAll('|','／').replaceAll('\n',' '),rows=(header:string[],data:any[][])=>'| '+header.join(' | ')+' |\n| '+header.map(()=> '---').join(' | ')+' |\n'+data.map(row=>'| '+row.map(esc).join(' | ')+' |').join('\n');
let doc='# 战斗特效来源及身份对应 · 2026-10-12\n\n';
doc+='本表由 `tools/document-combat-effects.mts` 从已解析的 Actor 引用、原始文件散列与正式身份数据生成。源版本为工程锁定的 SC2 5.0.16.97563；自定义精英与英雄仍采用本游戏已批准机制。完整可读来源链保存在 `reports/local/combat-effects-20261012/source-map.json`；可版本控制的来源、身份和适配器散列在 `reports/qa/combat-effects-sources-20261012.json`。\n\n';
doc+=`覆盖 ${ledger.counts.ordinary} 普通、${ledger.counts.elite} 精英、${ledger.counts.hero} 英雄；${routes.length} 武器／支持分支，${all.length} 原始模型定义，${ledger.counts.particleEmitters} 个粒子发射器、${ledger.counts.ribbons} 条光带、${ledger.counts.projections} 个投影定义。提取读取 ${extraction.sources.length} 个 M3／DDS 源文件；全部源文件只读并逐一核对散列。\n\n`;
doc+='## 武器与效果层\n\n';
doc+='各层读取原始动画曲线、颜色、透明度、纹理、混合方式、发射率与粒子运动。瞬时武器在实际命中回执播放冲击；在途武器读取真实 `WeaponFlight` 位置；持续光束、治疗和区域从现有状态重建。轨迹、命中时刻、伤害及范围仍由模拟决定。\n\n';
doc+=rows(['分支／兵种','武器／形态','发射挂点','模型分层','结束方式'],routes.map((r:any)=>[r.key+' · '+(SC2_UNITS[r.family as keyof typeof SC2_UNITS]?.name??(r.family==='shield'?'目标护盾':'通用支持')),(r.weapon??'支持')+(r.mode?' / '+r.mode:''),r.mounts.join('；'),Object.entries(r.models).map(([k,v]:any)=>k+': '+v.join(', ')).join('；')||r.adaptation||'原身体攻击动作及真实受击表面',r.kind==='healing'||r.kind==='repair'?'实际恢复关系结束；瞬时输血反馈自然消散':['beam','field','sweep','flame'].includes(r.kind)?'原状态结束；源 Birth/Stand/Death 与粒子寿命':'真实命中或原发射回执后，按源动画／粒子寿命消散']))+'\n\n';
doc+='## 普通身份\n\n'+rows(['身份','名称','基础分支'],identityRows.filter(r=>r.kind==='ordinary').map(r=>[r.id,r.name,r.routes.join('；')]))+'\n\n';
doc+='## 精英身份和既有特殊机制\n\n基础枪口、弹体、光束与冲击由对应原始分支负责；已有特殊机制层保留。原身体皮肤不被替换，源效果不按精英统一改色。附加连射、扇形、地刺、胆汁、光束强度和第三次挥砍读取现有精英状态。下列机制描述来自正式精英规则表，不能把列出机制视为该机制已完成画面验收；实际触发记录见验证报告及画廊。\n\n';
doc+=rows(['身份','名称','基础分支','既有特殊机制'],identityRows.filter(r=>r.kind==='elite').map(r=>[r.id,r.name,r.routes.join('；'),r.special]))+'\n\n';
doc+='## 英雄身份\n\n18 位英雄由已批准的专属攻击、技能、死亡和光环适配器继续负责；`CombatFxProfile` 排除英雄及英雄所属子单位。英雄同名基础兵种不能抢占这些效果。\n\n'+rows(['身份','名称','原有技能','归属'],identityRows.filter(r=>r.kind==='hero').map(r=>[r.id,r.name,r.special,'已批准专属英雄适配器']))+'\n\n';
doc+='## 原始模型散列\n\n同一路径允许多个模型定义共享，但定义的缩放、动画及 Actor 层仍各自保留。\n\n'+rows(['模型定义','原文件','SHA-256','网格／粒子／光带／投影'],ledger.models.map(m=>[m.id,m.file,m.sha256,[m.mesh?'有':'无',m.particles,m.ribbons,m.projections].join(' / ')]))+'\n\n';
doc+='## 挂点、状态和适配边界\n\n- 劫掠者按原生射击序列奇偶交替左右炮口；雷神高冲击按原始 Attachment Method 的两组炮口交替；死神、女妖、维京和凤凰保留各自成对挂点。所有挂点来自原身体及实际攻击姿势。\n- 狂热者、雷兽与不朽者只补其原身体附属的发射器／光带，不额外复制一份身体网格。不朽者屏障和此前已修复死亡材质保留。\n- 截击机从实际子单位发射；航母自身不产生伪造攻击光束。5 种形态与敌方 9 类×3 层级读取实际身份及武器。建筑、工人、载体、死亡和召唤物仍由对应原生生命周期负责。\n- 短期视觉回执不新增存档字段；读档不会补播已经结束的命中。持续效果从现有状态重建，暂停冻结游戏时钟，粒子随机值独立于 World RNG。\n- 支持原始网格、标准／复合材质、动画粒子、光带及贴地投影。M3 的 type 2 屏幕位移材质未实现背景折射，涉及下列模型；这些附加背景扭曲层不作为已还原属性：'+displacement.join(', ')+'。\n- 科学球沿用已经确认的受治疗者纳米修复雾，历史原始来源限制仍开放。原版客户端逐画面对照、真实设备、自然流程与人工验收不因本表生成而通过。\n\n';
doc+='## 已核对适配器\n\n'+rows(['文件','SHA-256'],hashes.map(r=>[r.file,r.sha256]))+'\n';
await fs.writeFile('docs/project/COMBAT_EFFECTS_SOURCES_20261012.md',doc);console.log(JSON.stringify(ledger.counts));
