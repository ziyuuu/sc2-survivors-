const identityRows=[...ALL_FAMILIES.map(id=>({id,kind:'ordinary',family:id,name:SC2_UNITS[id].name,race:familyRace(id),routes:baseRoutes(id),special:null})),...Object.values(ELITES).map(e=>({id:e.id,kind:'elite',family:e.family,name:e.name,race:familyRace(e.family),routes:baseRoutes(e.family),special:e.description})),...Object.entries(HEROES).map(([id,h])=>({id,kind:'hero',family:h.baseFamily,name:h.name,race:h.race,routes:[],special:h.skill,owner:'Approved dedicated hero adapters; excluded from source family fallback'}))];
