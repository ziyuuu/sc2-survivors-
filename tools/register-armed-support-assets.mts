/** Register only this batch; preserve the workspace's optimized runtime baseline. */
import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {inspectGlb} from './glb-inspect.mjs';
const manifest=JSON.parse(await fs.readFile('assets/private/m3-pack.json','utf8')).manifest;
const bio=process.argv.includes('--bio');
const definitions=bio?JSON.parse(await fs.readFile('tools/bio-models.json','utf8')).filter((r:any)=>r.id.startsWith('model.')):[...JSON.parse(await fs.readFile('tools/armed-support-models.json','utf8')),...JSON.parse(await fs.readFile('tools/armed-support-props.json','utf8'))];
const derivatives=JSON.parse(await fs.readFile('assets/private/m6-webp-manifest.json','utf8')).records;
const records:Record<string,unknown>[]=[];
const shipping:Record<string,unknown>[]=[];
const unused=new Set(['model.support.sensor_payload']);
for(const definition of definitions){
 const entry=manifest.find((a:{id:string})=>a.id===(definition.sharedModel??definition.id));if(!entry)continue;
 let file=entry.packedFile,expected=entry.sha256;
 try{await fs.access(file);}catch{const derivative=derivatives.find((d:any)=>d.id===entry.id&&d.sourceSha256===entry.sha256);if(!derivative)throw Error('Missing verified derivative '+entry.id);file=derivative.packedFile;expected=derivative.sha256;}
 const bytes=await fs.readFile(file),sha=createHash('sha256').update(bytes).digest('hex'),info=inspectGlb(bytes);
 if(sha!==expected||!entry.sourceSha256||!entry.sourcePath||info.externalResources.length||!info.animationNames.length)throw Error('Unverified armed asset '+definition.id);
 if(unused.has(definition.id))continue;
 const record={id:definition.id,kind:'model',status:'available',url:file.replace('public/',''),required:false};records.push(record);
 const gitPath='deploy/runtime/assets/'+sha+'.glb';try{const existing=await fs.readFile(gitPath);if(createHash('sha256').update(existing).digest('hex')!==sha)throw Error('Immutable resource changed '+gitPath);}catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;await fs.writeFile(gitPath,bytes);}
 shipping.push({...record,packedFile:file,gitPath,bytes:bytes.length,packedSha256:sha,sourcePath:entry.sourcePath,sourceBuild:entry.sourceBuild,sourceSha256:entry.sourceSha256,animations:entry.animations});
 console.log(definition.id+' '+bytes.length+' '+info.animationNames.length+' clips');
}
const generated='// Generated by tools/register-armed-support-assets.mts.\nexport const '+(bio?'BIO_ASSETS':'ARMED_SUPPORT_ASSETS')+' = '+JSON.stringify(records,null,2)+';\n';
await fs.writeFile(bio?'src/assets/bio.ts':'src/assets/armed-support.ts',generated);
await fs.writeFile(bio?'deploy/runtime/bio-assets.json':'deploy/runtime/armed-support-assets.json',JSON.stringify({version:1,generatedSha256:createHash('sha256').update(generated).digest('hex'),records:shipping},null,2)+'\n');
