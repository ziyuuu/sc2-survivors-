const won=make('industrial','terran');won.stage=18;won.prepareStage();won.hive!.hp=0;const special=campaign18Schedule(campaign18StageConfig(18,won.difficulty),529).specials[0],boss=(won as any).spawnCampaignSpecial(special);assert.ok(boss);won.hit(boss,1e9,[],1,'terran');won.stageElapsed=won.duration;won.endStage();assert.equal(won.phase,'won');won.paused=true;fixtures.won=path.resolve(out,'won.json');await fs.writeFile(fixtures.won,writeArchive({profile:won.permanentProfile.exportJSON(),run:won.captureRun()}));
const server=createGameServer({webRoot:path.resolve(web),assetRoot:path.resolve('deploy/runtime'),backendOptions:{config:{enabled:false}}});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,args:['--allow-file-access-from-files']}),context=await browser.newContext({viewport:{width:1440,height:900},hasTouch:true});if(offline)await context.setOffline(true);await context.addInitScript('window.__name=(v)=>v;');const page=await context.newPage();page.setDefaultTimeout(120000);
const report:any={at:new Date().toISOString(),build,offline,entryOnly,missing:missing??null,method:entryOnly?'Actual final formal Web entry checks with paused current-source native archive fixtures, five-map replacement and independent endless entry. No context-restore, natural campaign or physical-device claim in this entry-only run.':'Actual formal Web / named self-contained HTML. Current-build paused native archive fixtures select maps; UI import, in-page map replacement, required readiness, native keyboard, pause, actual WebGL restoration and same-build save reload. Won fixture selects endless. No natural campaign, legacy migration or physical-device claim.',maps:[],checks:[],screens:[],exports:[],errors:[],consoleErrors:[],httpErrors:[],offlineRequests:[]};
if(offline){const b=await fs.readFile(html);report.html={path:html,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')};}
page.on('pageerror',e=>report.errors.push(e.message));page.on('console',m=>{if(m.type()==='error')report.consoleErrors.push(m.text())});page.on('response',r=>{if(r.status()>=400)report.httpErrors.push({url:r.url(),status:r.status()})});page.on('request',r=>{if(offline&&r.url().startsWith('http'))report.offlineRequests.push(r.url())});
const entry=offline?pathToFileURL(path.resolve(html)).href:'http://127.0.0.1:'+(server.address() as any).port,runtime=()=>page.evaluate(()=>(window as any).__SC2_REPORT__());
const heartbeat=setInterval(()=>{void page.evaluate(()=>{const r=(window as any).__SC2_REPORT__?.();return r?{phase:r.phase,stage:r.stage,time:r.time,readiness:r.readiness,assetsPending:r.assetsPending,errors:r.errors}:null}).then(state=>fs.writeFile(out+'/live.json',JSON.stringify({at:new Date().toISOString(),state},null,2))).catch(()=>{});},30000);
async function progress(label:string){report.progress={label,at:new Date().toISOString()};await fs.writeFile(out+'/progress.json',JSON.stringify(report,null,2));console.log(label);}
async function shot(name:string){await page.locator('#overlay').evaluate(async el=>{await Promise.all(el.getAnimations({subtree:true}).filter(a=>a.effect?.getTiming().iterations!==Infinity).map(a=>a.finished.catch(()=>{})))});await page.screenshot({path:out+'/'+name+'.png'});report.screens.push({name,runtime:await runtime()});await progress(name);}
async function ready(){await page.waitForFunction(()=>['ready','error'].includes((window as any).__SC2_REPORT__?.().readiness?.phase),null,{timeout:900000});const r=await runtime();assert.equal(r.readiness.phase,'ready',JSON.stringify(r.readiness));assert.equal(r.assetsPending,0);assert.equal(r.sourceCombat.source.ready,true);assert.deepEqual(r.errors,[]);await page.locator('[data-action="flow-continue"]').click();}
async function select(name:string){await page.locator('.main-actions [data-action="menu-load"]').click();const event=page.waitForEvent('filechooser');await page.locator('[data-action="menu-load-file"]').click();await(await event).setFiles(fixtures[name]);await page.locator('[data-action="menu-load-ready"]').click();}
async function menu(){if(page.url()==='about:blank')await page.goto(entry,{timeout:600000});else if((await runtime()).phase!=='menu')await page.locator('.pause-actions [data-action="restart"]').click();await page.waitForFunction(()=>(window as any).__SC2_REPORT__?.().phase==='menu',null,{timeout:900000});}
async function load(name:string){await menu();await progress(name+' preparing');await select(name);await ready();}
async function exported(label:string){await page.locator('[data-action="pause-saves"]').click();const event=page.waitForEvent('download');await page.locator('[data-action="save-export"]').click();const text=await fs.readFile(await(await event).path(),'utf8');await fs.writeFile(out+'/'+label+'.json',text);report.exports.push(label+'.json');await page.locator('[data-action="archives-back"]').last().click();return readArchive(text).bundle.run!;}
const canonical=(run:any,notice=false)=>{const copy=structuredClone(run);if(notice){copy.state.notice='';copy.state.noticeUntil=0}return encodeGraph(copy)};
async function restore(label:string){const before=await exported(label+'-before-restore');await page.evaluate(async()=>{const canvas=document.querySelector('#battle') as HTMLCanvasElement,gl=canvas.getContext('webgl2')!,ext=gl.getExtension('WEBGL_lose_context');if(!ext)throw Error('Missing WebGL loss extension');await new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Restore event timeout')),30000);canvas.addEventListener('webglcontextrestored',()=>{clearTimeout(timer);resolve()},{once:true});canvas.addEventListener('webglcontextlost',()=>setTimeout(()=>ext.restoreContext(),200),{once:true});ext.loseContext()})});await page.waitForFunction(()=>{const r=(window as any).__SC2_REPORT__();return !r.readiness.kind&&!r.assetsPending&&r.sourceCombat.source.ready&&r.shadows.ready&&r.contact.ready},null,{timeout:900000});const after=await exported(label+'-after-restore');assert.deepEqual(canonical(after,true),canonical(before,true));await shot(label+'-actual-restore');report.checks.push({kind:'actual-webgl-restore',label,nativeStateExact:true,normalization:['notice','noticeUntil']});}
async function reload(label:string){await page.locator('[data-action="pause-saves"]').click();await page.locator('[data-action="save-now"]').click();await page.waitForFunction(()=>(window as any).__SC2_REPORT__().save.message.includes('已保存'));await page.locator('[data-action="archives-back"]').last().click();const before=await exported(label+'-before-reload');await page.reload({timeout:600000});await page.waitForFunction(()=>(window as any).__SC2_REPORT__?.().phase==='menu',null,{timeout:900000});await page.locator('.main-actions [data-action="menu-load"]').click();await page.locator('[data-action="menu-load-local"]').click();await page.locator('[data-action="menu-load-ready"]').click();await ready();const after=await exported(label+'-after-reload');assert.deepEqual(canonical(after),canonical(before));await shot(label+'-actual-reload');report.checks.push({kind:'same-build-save-page-reload',label,nativeStateExact:true,normalization:[]});}
try{
 if(missing){
  const theme=(option('theme')??'char') as CampaignTheme,asset=manifest.assets[missing];assert.ok(asset,missing);await page.route('**/'+asset.url,r=>r.fulfill({status:404,body:'Intentional missing environment resource fixture'}));await menu();await select(theme);await page.waitForFunction(()=>(window as any).__SC2_REPORT__?.().readiness.phase==='error',null,{timeout:900000});const failed=await runtime();assert.equal(failed.phase,'menu');assert.equal(failed.time,0);assert.ok(failed.readiness.error);await shot('missing-resource');report.checks.push({kind:'missing-resource-gate',id:missing,state:failed});await page.unroute('**/'+asset.url);await page.locator('[data-action="flow-retry"]').click();await ready();assert.equal((await runtime()).map.environment.sample.decoration.layout,'full-map');await shot('resource-retry-recovered');report.checks.push({kind:'resource-retry',state:await runtime()});assert.ok(report.httpErrors.length>0);assert.ok(report.httpErrors.every((r:any)=>r.status===404&&r.url.endsWith(asset.url)));
 }else{
  for(const theme of themes){await load(theme);const start=await runtime();assert.equal(start.map.name,MAP_THEMES[theme].name);assert.equal(start.map.environment.sample.decoration.groups,20);assert.equal(await page.evaluate(()=>typeof (window as any).__SC2_DEBUG__),'undefined');assert.equal(await page.evaluate(()=>typeof (window as any).__MVP5_NATIVE__),'undefined');await shot(theme+'-ready');
   if(entryOnly){report.maps.push({theme,start});report.checks.push({kind:'formal-map-entry',theme});continue;}
   const paused=await exported(theme+'-paused');await page.waitForTimeout(800);assert.deepEqual(canonical(await exported(theme+'-paused-later')),canonical(paused));report.checks.push({kind:'pause-state',theme});await restore(theme);if(theme==='industrial')await reload(theme);
   await page.locator('.pause-actions [data-action="settings"]').click();await page.locator('[data-action="settings-tab"][data-tab="controls"]').click();await page.locator('[data-setting="desktop"]').selectOption('keyboard');await page.locator('[data-action="settings-back"]').last().click();await page.locator('.pause-actions [data-action="pause"]').click();const from=(await runtime()).time;await page.locator('#battle').focus();await page.keyboard.down('d');await page.waitForFunction((t:number)=>(window as any).__SC2_REPORT__().time>=t+.6,from,{timeout:120000});await page.keyboard.up('d');await shot(theme+'-active');await page.locator('#topbar [data-action="pause"]').click();const moved=await exported(theme+'-moved');assert.ok(Math.hypot(moved.state.anchor.x,moved.state.anchor.z)>.1);report.maps.push({theme,start,after:await runtime(),movedAnchor:moved.state.anchor});
  }
  await load('won');await page.locator('[data-action="endless"]:visible').click();await page.locator('.reward-actions [data-action="skip"]').click();await page.locator('.reward-actions [data-action="skip"]').click();await page.locator('[data-action="endless-prepare"]:visible').click();await ready();const endless=await runtime();assert.ok(endless.endless);assert.equal(endless.map.environment.flat,true);assert.equal(endless.map.placements,0);assert.equal(endless.map.environment.ground.profile,'char');await shot('endless-entered');if(!entryOnly){if(!await page.locator('[data-action="pause-saves"]').isVisible())await page.locator('#topbar [data-action="pause"]').click();await restore('endless');await reload('endless');}report.checks.push({kind:'independent-endless-flat-map',state:endless});
  assert.deepEqual(report.httpErrors,[]);assert.deepEqual(report.consoleErrors,[]);
 }
 assert.deepEqual(report.errors,[]);assert.deepEqual(report.offlineRequests,[]);report.passed=true;
}catch(error){report.passed=false;report.failure=String((error as Error).stack??error);await shot('failure').catch(()=>{});process.exitCode=1;}
finally{clearInterval(heartbeat);report.finishedAt=new Date().toISOString();await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));await browser.close();await new Promise<void>(r=>server.close(()=>r()));console.log(JSON.stringify({passed:report.passed,maps:report.maps.length,screens:report.screens.length,checks:report.checks.length,error:report.failure}));}
