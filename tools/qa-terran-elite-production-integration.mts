function fixture(ids:TerranEliteId[]){
 const w=new World({race:'terran',seed:10530,waves:false,terrain:campaignTerrain(chooseCampaignMap(10530))});w.start();w.entities.clear();w.heroes.clear();w.pods=[];w.expedition.ledger=[];w.hive=null;w.expansionHives.clear();w.economicTargets.clear();w.fortifications.clear();w.pickups=[];w.rewardDrops=[];w.time=10;w.tick=600;w.wallet={minerals:10000,gas:10000};for(const p of Object.values(w.expedition.production))p.enabled={};
