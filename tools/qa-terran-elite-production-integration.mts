 for(const id of ids){const q=w.freePosition(id.startsWith('viking.')?'thor':ELITES[id].family,w.anchor,2,6);assert.ok(q,'legal source '+id);const u=w.addUnit(ELITES[id].family,'terran',q.x,q.z,5);u.eliteId=id;u.modelKey=ELITES[id].model;w.expedition.tech['unlock.'+u.unitType]=1;w.refreshStats(u,true);u.energy=u.maxEnergy;units.push(u);
