 w.time+=3/60;w.tick+=3;w.paused=true;const before=w.captureRun();assert.equal(before.schema,21);assert.equal(before.state.phase,'battle');const test=new World({race:'terran'});test.restoreRun(before);return {w,before};
}
const fixtures=[];for(const ids of groups){const f=fixture(ids),file=path.resolve(out,ids[0]+'.json');await fs.writeFile(file,writeArchive({profile:f.w.permanentProfile.exportJSON(),run:f.before}));fixtures.push({...f,ids,file});}
if(process.argv.includes('--fixtures-only')){console.log(JSON.stringify(fixtures.map(f=>({ids:f.ids,file:f.file,packets:f.before.state.weaponFlights.length,areas:f.before.state.terranElites.areas.length,mines:f.before.state.p4Samples.mines.length,fires:f.before.state.p4Samples.fires.length,deploy:f.before.state.p4Samples.deploy,absorptions:f.before.state.terranElites.absorptions.length}))));process.exit(0);}
const release=JSON.parse(await fs.readFile('dist/web/web-release.json','utf8'));const report:any={method:'Actual production World-built schema21 diagnostic archives with genuine delayed primary/derived elite flights, native transitions, radiation/EMP, mine deployment and one original paid Reaper absorption receipt. Production file-import UI followed by save/export/reload/local-load in isolated contexts. No production debug API or live-state mutation; separate from natural acquisition, human/performance acceptance.',appBuildId:release.appBuildId,checks:[],errors:[]};const server=createGameServer({webRoot:path.resolve('dist/web')});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,args:['--allow-file-access-from-files']});report.browser=browser.version();let page:any;
const ready=async()=>{await page.waitForFunction(()=>['ready','error'].includes(window.__SC2_REPORT__?.().readiness?.phase),null,{timeout:240000});const r=await page.evaluate(()=>window.__SC2_REPORT__());assert.equal(r.readiness.phase,'ready',JSON.stringify(r.readiness));};
