try{for(const {ids,before,file} of fixtures){const context=await browser.newContext({viewport:{width:1440,height:1000},acceptDownloads:true});page=await context.newPage();page.on('pageerror',(e:any)=>report.errors.push(e.message));await page.goto(process.env.QA_OFFLINE_HTML?pathToFileURL(path.resolve(process.env.QA_OFFLINE_HTML)).href:`http://127.0.0.1:${(server.address() as any).port}/`,{timeout:240000});await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu');assert.equal(await page.evaluate(()=>typeof window.__SC2_DEBUG__),'undefined');await page.locator('[data-action=menu-load]').click();const chooser=page.waitForEvent('filechooser');await page.locator('[data-action=menu-load-file]').click();await(await chooser).setFiles(file);await page.locator('[data-action=menu-load-ready]').click();await ready();await page.locator('[data-action=flow-continue]').click();await page.waitForFunction(()=>window.__SC2_REPORT__().phase==='battle');
 const restored=await exportRun();assert.equal(restored.schema,21);assert.deepEqual(mechanisms(restored.state),mechanisms(before.state));assert.equal(restored.state.time,before.state.time);assert.equal(restored.state.paused,true);const r=await page.evaluate(()=>window.__SC2_REPORT__());assert.equal(r.terranElites.medical.beams,ids.includes('medivac.2')?5:ids.includes('medivac.1')?1:0);assert.deepEqual(r.errors,[]);await page.screenshot({path:out+'/'+ids[0]+'-import-paused.png'});
 await page.locator('.end-screen [data-action=pause]').click();await page.waitForFunction(time=>window.__SC2_REPORT__().time>time+1.4,before.state.time,{timeout:30000});await page.screenshot({path:out+'/'+ids[0]+'.png'});await page.locator(`[data-seat="${ELITES[ids[0]].family}:0"]`).first().click();await page.screenshot({path:out+'/'+ids[0]+'-details.png'});await page.locator('[data-inspect-close]').click();
 await page.locator('#topbar [data-action=pause]').click();await page.locator('[data-action=save-now]').click();await page.waitForFunction(()=>window.__SC2_REPORT__().save.message.includes('已保存'));const after=await exportRun();assert.ok(after.state.stats.damage>before.state.stats.damage);assert.equal(after.schema,21);assert.equal(after.state.p4Samples.enabled,false);
 await page.reload({timeout:240000});await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu');await page.locator('[data-action=menu-load]').click();await page.locator('[data-action=menu-load-local]').click();await page.locator('[data-action=menu-load-ready]').click();await ready();await page.locator('[data-action=flow-continue]').click();const loaded=await exportRun();assert.deepEqual(mechanisms(loaded.state),mechanisms(after.state));assert.equal(loaded.state.time,after.state.time);assert.equal(loaded.state.paused,true);assert.deepEqual(encodeGraph(loaded.state.wallet),encodeGraph(after.state.wallet));assert.deepEqual(encodeGraph(loaded.state.expedition.ledger),encodeGraph(after.state.expedition.ledger));report.checks.push({ids,schema:loaded.schema,importedPackets:before.state.weaponFlights.length,areas:before.state.terranElites.areas.length,mines:before.state.p4Samples.mines.length,barriers:before.state.p4Samples.barriers.length,absorptions:before.state.terranElites.absorptions.length,heroAura:ids.includes('medivac.1')?[...loaded.state.entities.values()].filter(u=>u.heroId).map(u=>({id:u.heroId,maxHp:u.maxHp,hp:u.hp,armor:u.armor,auraFactor:u.eliteHpAuraFactor})):[],damage:after.state.stats.damage-before.state.stats.damage,healed:after.state.stats.healed-before.state.stats.healed,saveRestored:true,mechanismsPreserved:true,debugApi:false});await context.close();console.log(ids.join('/')+': production integration passed');}assert.deepEqual(report.errors,[]);assert.equal(JSON.parse(await fs.readFile('dist/web/web-release.json','utf8')).appBuildId,report.appBuildId);
