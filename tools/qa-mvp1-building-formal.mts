import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {chromium,type Page} from '@playwright/test';
import {createGameServer} from './coze-web-server.mjs';

const out=process.argv[2],web=process.argv.find(a=>a.startsWith('--web='))?.slice(6)??'dist/MVP1-Building-Main-20261013-R1';
if(!out||!['reports/local/mvp1-building-main-20261013/','reports/local/mvp5-full-map-20261014/'].some(prefix=>out.startsWith(prefix))||out.includes('..'))throw Error('Unsafe evidence directory');await fs.access(out).then(()=>{throw Error('Evidence exists');},e=>{if(e.code!=='ENOENT')throw e;});await fs.mkdir(out,{recursive:true});await fs.copyFile(new URL(import.meta.url),out+'/runner.mts');await fs.copyFile(web+'/build-inputs.json',out+'/build.json');
const build=JSON.parse(await fs.readFile(web+'/web-release.json','utf8'));assert.equal(build.diagnostic,false);
const server=createGameServer({webRoot:path.resolve(web),assetRoot:path.resolve('deploy/runtime'),backendOptions:{config:{enabled:false}}});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true}),entry='http://127.0.0.1:'+(server.address() as any).port;
const report:any={at:new Date().toISOString(),build,method:'Actual named production Web with no native-reference/debug exposure, fresh new-run menus, public read-only report, original pointer/keyboard/pause/settings/resize controls and one actual paused WebGL restore. No archive imports, rich wallet, forced stage/arrival, full campaign, human/physical device, balance or performance acceptance.',races:[],checks:[],screens:[],errors:[],consoleErrors:[],httpErrors:[]};let page:Page|undefined;
const read=()=>page!.evaluate(()=>(window as any).__SC2_REPORT__());
async function shot(label:string){await page!.locator('#overlay').evaluate(async el=>{await Promise.all(el.getAnimations({subtree:true}).filter(a=>a.effect?.getTiming().iterations!==Infinity).map(a=>a.finished.catch(()=>{})));});await page!.screenshot({path:out+'/'+label+'.png'});report.screens.push({label,runtime:await read()});}
const native=(r:any)=>({phase:r.phase,stage:r.stage,time:r.time,stats:r.stats,wallet:r.wallet,expedition:r.expedition,order:r.order});
async function panel(){await page!.locator('.pause-actions [data-action="pause-production"]').click();assert.equal(await page!.locator('.wb-base-tabs [role="tab"]').count(),3);await page!.locator('.wb-base-tabs [data-tab="facilities"]').click();await page!.locator('.production-modal').evaluate(async el=>{await Promise.all(el.getAnimations({subtree:true}).filter(a=>a.effect?.getTiming().iterations!==Infinity).map(a=>a.finished.catch(()=>{})));});}
try{
 const requestedRace=process.argv.find(a=>a.startsWith('--race='))?.slice(7);if(requestedRace&&!['terran','zerg','protoss'].includes(requestedRace))throw Error('Unknown race');
 for(const race of requestedRace?[requestedRace]:['terran','zerg','protoss']){
  const context=await browser.newContext({viewport:{width:1440,height:900},hasTouch:true});await context.addInitScript('window.__name=(value)=>value;');page=await context.newPage();page.setDefaultTimeout(120000);page.on('pageerror',e=>report.errors.push({race,error:e.message}));page.on('console',m=>{if(m.type()==='error')report.consoleErrors.push({race,error:m.text()});});page.on('response',r=>{if(r.status()>=400)report.httpErrors.push({race,url:r.url(),status:r.status()});});
  await page.goto(entry,{timeout:600000});await page.waitForFunction(()=>(window as any).__SC2_REPORT__?.().phase==='menu',null,{timeout:900000});assert.equal(await page.evaluate(()=>typeof (window as any).__MVP1_NATIVE__),'undefined');assert.equal(await page.evaluate(()=>typeof (window as any).__SC2_DEBUG__),'undefined');
  await page.locator('.main-actions [data-action="menu-new"]').click();await page.locator('[data-action="menu-race"][data-race="'+race+'"]').click();await page.locator('[data-action="menu-race-next"]').click();await page.locator('[data-action="menu-difficulty"][data-difficulty="easy"]').click();await page.locator('[data-action="menu-difficulty-next"]').click();await page.locator('[data-action="menu-start"]').click();await page.waitForFunction(()=>['ready','error'].includes((window as any).__SC2_REPORT__().readiness?.phase),null,{timeout:900000});const prepared=await read();assert.equal(prepared.readiness.phase,'ready',JSON.stringify(prepared.readiness));assert.equal(prepared.assetsPending,0);assert.equal(prepared.sourceCombat.source.ready,true);await page.locator('[data-action="flow-continue"]').click();await page.waitForFunction(()=>(window as any).__SC2_REPORT__().phase==='battle');await page.locator('#topbar [data-action="pause"]').click();await shot(race+'-formal-native-opening');console.log(race+' formal new-run ready');
  const before=await read();await panel();const enabled=page.locator('.wb-facility [data-action="building-enable"]').first();assert.equal(await enabled.getAttribute('aria-pressed'),'true');assert.equal(await page.locator('[data-action="building-output"]:not(:disabled)').count(),0);await enabled.click();await page.locator('.wb-base-tabs [data-tab="technology"]').click();await page.locator('.wb-base-tabs [data-tab="technology"]').focus();await page.keyboard.press('End');assert.equal(await page.locator('.wb-base-tabs [data-tab="production"]').getAttribute('aria-selected'),'true');await shot(race+'-formal-paused-tree');await page.keyboard.press('Escape');assert.deepEqual(native(await read()),native(before));assert.equal(await page.locator('.pause-actions [data-action="pause-production"]').evaluate(el=>el===document.activeElement),true);
  await panel();assert.equal(await enabled.getAttribute('aria-pressed'),'true');await enabled.click();await page.locator('[data-action="building-panel-apply"]').click();await panel();assert.equal(await enabled.getAttribute('aria-pressed'),'false');await page.locator('.production-modal .modal-heading [data-action="pause-production-close"]').click();assert.equal(await page.locator('.pause-actions [data-action="pause-production"]').evaluate(el=>el===document.activeElement),true);report.checks.push({kind:'formal-pause-draft-cancel-apply-close',race,before,after:await read()});
  await page.locator('.pause-actions [data-action="settings"]').click();await page.locator('[data-action="settings-tab"][data-tab="controls"]').click();await page.locator('[data-setting="desktop"]').selectOption('keyboard');await page.locator('[data-action="settings-back"]').last().click();await page.locator('.pause-actions [data-action="pause"]').click();const start=(await read()).time;await page.locator('#battle').focus();await page.keyboard.down('d');await page.waitForFunction((time:number)=>(window as any).__SC2_REPORT__().time>=time+.6,start,{timeout:120000});await page.keyboard.up('d');await shot(race+'-formal-active-native-movement');await page.locator('#topbar [data-action="pause"]').click();const moved=await read();assert.equal(moved.controls.desktop,'keyboard');assert.ok(Math.hypot(moved.camera.target[0]-before.camera.target[0],moved.camera.target[2]-before.camera.target[2])>.1,'Native keyboard anchor-follow did not move');await shot(race+'-formal-keyboard-moved');report.checks.push({kind:'formal-native-keyboard',race,start,moved});
  await panel();await page.setViewportSize({width:390,height:844});await page.locator('.wb-base-tabs [data-tab="technology"]').click();await page.locator('.production-modal').evaluate(async el=>{await Promise.all(el.getAnimations({subtree:true}).filter(a=>a.effect?.getTiming().iterations!==Infinity).map(a=>a.finished.catch(()=>{})));});await shot(race+'-formal-portrait-technology');assert.equal(await page.locator('.modal-content').last().evaluate(el=>el.scrollWidth>el.clientWidth+1),false);await page.keyboard.press('Escape');await page.setViewportSize({width:1440,height:900});
  if(race==='terran'){
   const before=await read();await page.evaluate(async()=>{const gl=(document.querySelector('#battle') as HTMLCanvasElement).getContext('webgl2')!,ext=gl.getExtension('WEBGL_lose_context');if(!ext)throw Error('Missing actual loss extension');await new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(Error('Restore event timeout')),30000);gl.canvas.addEventListener('webglcontextrestored',()=>{clearTimeout(timer);resolve();},{once:true});gl.canvas.addEventListener('webglcontextlost',()=>setTimeout(()=>ext.restoreContext(),200),{once:true});ext.loseContext();});});await page.waitForFunction(()=>{const r=(window as any).__SC2_REPORT__();return !r.readiness.kind&&r.assetsPending===0&&r.sourceCombat.source.ready&&r.shadows.ready&&r.contact.ready;},null,{timeout:900000});const after=await read();assert.deepEqual(native(after),native(before));await shot('terran-formal-actual-context-restored');report.checks.push({kind:'actual-paused-context-restore',before,after,nativeStateExact:true});
  }
  report.races.push({race,final:await read()});console.log(race+' formal controls passed');await context.close();page=undefined;
 }
 assert.deepEqual(report.errors,[]);assert.deepEqual(report.consoleErrors,[]);assert.deepEqual(report.httpErrors,[]);report.passed=true;
}catch(error){report.passed=false;report.failure=String((error as Error).stack??error);if(page)await shot('failure').catch(()=>{});process.exitCode=1;}
finally{report.finishedAt=new Date().toISOString();await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));await browser.close();await new Promise<void>(r=>server.close(()=>r()));console.log(JSON.stringify({passed:report.passed,races:report.races.length,screens:report.screens.length,checks:report.checks.length,error:report.failure}));}
