import {createGameServer} from './coze-web-server.mjs';import {World} from '../src/simulation/world';import {writeArchive,readArchive} from '../src/persistence/archive';import {encodeGraph} from '../src/persistence/graph-codec';import {campaignTerrain,chooseCampaignMap} from '../src/data/campaign-map';import {ELITES} from '../src/data/elites';import type {Entity} from '../src/simulation/types';import type {ProtossEliteId} from '../src/data/protoss-elites';import {protossEliteCombat,protossEliteAbility,tickProtossElite} from '../src/simulation/combat/protoss-elite-runtime';import {initializeCarrierSubsystem} from '../src/simulation/combat/carriers';
const out=process.env.QA_OUT??'reports/local/protoss-elites-auras-20261005/production';await fs.mkdir(out,{recursive:true});
const allGroups:ProtossEliteId[][]=[['zealot.1','zealot.2','zealot.3','adept.1','adept.2','adept.3'],['stalker.1','stalker.2','stalker.3','sentry.1','sentry.2','sentry.3'],['immortal.1','immortal.2','immortal.3','colossus.1','colossus.2','colossus.3'],['high_templar.1','high_templar.2','high_templar.3','phoenix.1','phoenix.2','phoenix.3'],['void_ray.1','void_ray.2','void_ray.3','carrier.1','carrier.2','carrier.3']];
