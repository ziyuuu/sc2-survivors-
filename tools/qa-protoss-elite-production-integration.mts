function fixture(ids:ProtossEliteId[]){const w=new World({race:'protoss',seed:10577,waves:false,terrain:campaignTerrain(chooseCampaignMap(10577))});w.start();w.entities.clear();w.heroes.clear();w.pods=[];w.expedition.ledger=[];w.hive=null;w.expansionHives.clear();w.economicTargets.clear();w.fortifications.clear();w.pickups=[];w.rewardDrops=[];w.time=10;w.tick=600;w.wallet={minerals:10000,gas:10000};for(const p of Object.values(w.expedition.production))p.enabled={};w.expedition.tech.storm=1;w.expedition.tech.charge=1;w.expedition.tech.blink=1;w.expedition.familySlots=[...new Set([...ids.map(id=>ELITES[id].family),'stalker','sentry'])];const units:Entity[]=[],targets=new Map<number,Entity>();
