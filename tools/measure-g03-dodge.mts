import fs from 'node:fs';import assert from 'node:assert/strict';
import {BASE,runtime,accountFor,dodgeTarget,round,distance} from './lib/g03-economy-runtime.mts';
const r=await runtime('current'),rows:any[]=[],formations=[{race:'terran',types:['marine','marine','marine','marine'],name:'marine'},{race:'terran',types:['thor','thor','thor','thor'],name:'thor'},{race:'zerg',types:['zergling','zergling','zergling','zergling'],name:'zergling'},{race:'zerg',types:['queen','queen','queen','queen'],name:'queen'},{race:'protoss',types:['zealot','zealot','zealot','zealot'],name:'zealot'},{race:'protoss',types:['immortal','immortal','immortal','immortal'],name:'immortal'}];
const policies=[{name:'idle',interval:1,vision:8},{name:'sweep',interval:.25,vision:8},...([.1,.25,.5,1] as const).map(interval=>({name:'reactive',interval,vision:8})),{name:'reactive',interval:.5,vision:16}];
for(const f of formations)for(const policy of policies)for(const startX of [-10,0,10]){
 const account=accountFor(r,f.race,0,529),w=new r.World({race:f.race,difficulty:'easy',seed:529,waves:true,terrain:new r.FlatTerrain(),obstacles:[],equipmentAccount:account});assert.ok(w.start());
 // Explicit controlled roster/stage, never claimed as a naturally obtained campaign party.
 w.stage=6;w.entities.clear();w.heroes.clear();w.pods=[];w.hive=null;w.expansionHives.clear();w.economicTargets.clear();for(const type of f.types)w.addUnit(type,'terran',0,0,3);
 assert.ok(r.beginSpecialStage(w,'dodge','fixture'));assert.ok(r.markSpecialReady(w));const a=w.specialStages.active;
 const before=a.participants.map((id:number)=>{const u=w.entities.get(id);return {id,type:u.unitType,rank:u.rank,hp:u.hp,shield:u.shield,speed:u.moveSpeed,radius:u.unitRadius};});
 const hits:any[]=[],positions:any[]=[],phrases=new Set();let next=0,inputs=0,attempts=0,travel=0,peak=0,last={...w.anchor},startActual:any=null;
 while(w.specialStages.active&&a.clock<3601){const t=a.clock/60;if(a.cue)phrases.add(a.cue.pattern);if(t>=next-1e-8){next=t+policy.interval;let p:any=null;if(t<3)p={x:startX,z:0};else if(policy.name==='sweep'){const route=[{x:-14,z:6},{x:14,z:6},{x:14,z:-6},{x:-14,z:-6}];p=route[Math.floor((t-3)/7)%4];}else if(policy.name==='reactive')p=dodgeTarget(w,1.5,policy.vision);if(p){attempts++;if(w.issueMove(p))inputs++;}else if(w.order)w.cancelOrder();}
  const oldHits=a.hits;w.step();travel+=distance(last,w.anchor);last={...w.anchor};peak=Math.max(peak,a.barrage.length);if(a.hits>oldHits)hits.push({seconds:a.clock/60,x:w.anchor.x,z:w.anchor.z,hit:a.hits});if(a.clock===180)startActual={x:w.anchor.x,z:w.anchor.z};if(a.clock%30===0)positions.push({seconds:a.clock/60,x:round(w.anchor.x),z:round(w.anchor.z),hits:a.hits,bullets:a.barrage.length});
 }
 assert.ok(!w.specialStages.active,'Challenge did not finish');assert.equal(a.hits>=5?w.specialStages.last.result==='failed':w.specialStages.last.result==='success',true);assert.equal(w.specialStages.last.ranks.length,4);
 const row={formation:f.name,race:f.race,policy,startX,startActual,seconds:a.clock/60,result:w.specialStages.last.result,hits:a.hits,firstHit:hits[0]?.seconds??null,inputAttempts:attempts,acceptedInputs:inputs,travel:round(travel),peakBullets:peak,phrases:[...phrases],before,after:w.specialStages.last.ranks,hitsTimeline:hits,positions};rows.push(row);
}
const groups=[];for(const f of formations)for(const p of policies){const x=rows.filter(x=>x.formation===f.name&&JSON.stringify(x.policy)===JSON.stringify(p));groups.push({formation:f.name,policy:p,n:x.length,success:x.filter(x=>x.result==='success').length,hits:x.map(x=>x.hits),seconds:x.map(x=>x.seconds),inputs:x.map(x=>x.acceptedInputs)});}
const report={pass:true,method:'Controlled legal four-body production dodge challenge at stage6/easy, rank3, no equipment, no health lock or rule overrides. Uses native issueMove, World.step, swept center collision, five hits, 1s grace and native rank settlement. Start X is approached through native movement during the 3s opening, not teleported. Reactive bot samples only projectiles within 8m (or16m sensitivity), predicts constant velocity from current projectile state; it does not inspect future cues/RNG. This is a simplified circular observation window, not an exact camera or human perception model. Input intervals are command sampling, not measured human reaction times. Three starting lanes are deterministic scenarios, not independent random trials.',rows,groups,limits:['No camera occlusion, rendering, real mouse motor timing or physical touch verification in this headless drill','Four same-type parties isolate native move-speed and size; not obtained naturally here','Success rate is descriptive over the three fixed starting lanes, not a population win probability']};fs.writeFileSync(BASE+'/dodge-r1.json',JSON.stringify(report,null,2));console.log(JSON.stringify({rows:rows.length,groups:groups.map(x=>({formation:x.formation,policy:x.policy,success:x.success,hits:x.hits,seconds:x.seconds}))}));
