import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {chromium} from '@playwright/test';
import {World} from '../src/simulation/world';
import {campaignTerrain,chooseCampaignMap} from '../src/data/campaign-map';
import {draftContext} from '../src/simulation/expedition-economy';
import {drawExpeditionReinforcements} from '../src/simulation/progression/expedition-drafts';
import {readArchive,writeArchive} from '../src/persistence/archive';
const out='reports/local/armed-support-design-20261111',base=process.env.SC2_QA_URL??'http://127.0.0.1:5196';
const w=new World({race:'terran',seed:1111045,waves:false,terrain:campaignTerrain(chooseCampaignMap(1111045))});w.starship.enabled=true;w.restoreRun(readArchive(await fs.readFile(out+'/player-start.json','utf8')).bundle.run!);
for(const id of ['W01','W01','W04','G01'])for(let i=0;i<2000;i++){const shelf=drawExpeditionReinforcements({...draftContext(w),currentOffers:[]},true),r=shelf.find(r=>r.expeditionEffect.kind==='armedSupport'&&r.expeditionEffect.cardId===id);if(r){w.rewards=shelf;assert.ok(w.choose(r.offerId));break;}}
const fixture=path.resolve(out,'node-layout.json');await fs.writeFile(fixture,writeArchive({profile:w.permanentProfile.exportJSON(),run:w.captureRun(),equipment:w.starship.account}));
const result:any={scope:'Production main entry, real World/HUD/card skin; simulated touch browser sizes, not physical phones.',checks:[],errors:[]};
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,args:['--no-proxy-server']});let page:any;
try{for(const [name,width,height]of [['landscape',844,390],['portrait',390,844]] as const){const context=await browser.newContext({viewport:{width,height},hasTouch:true,isMobile:true,deviceScaleFactor:1});page=await context.newPage();page.on('pageerror',(e:any)=>result.errors.push(e.message));await page.goto(base+'/',{timeout:180000});await page.locator('[data-action=settings]:visible').first().click();await page.locator('[data-action=settings-tab][data-tab=saves]').tap();const picker=page.waitForEvent('filechooser');await page.locator('[data-action=menu-load-file]').tap();await(await picker).setFiles(fixture);await page.waitForFunction(()=>['ready','error'].includes(window.__SC2_REPORT__?.().readiness.phase),null,{timeout:180000});assert.equal((await page.evaluate(()=>window.__SC2_REPORT__())).readiness.phase,'ready');await page.locator('[data-action=flow-continue]').tap();await page.locator('[data-action=armed-node]').first().waitFor();await page.waitForTimeout(250);
 const measure=await page.evaluate(()=>({layout:document.querySelector('#overlay').getAttribute('data-layout'),width:innerWidth,overflow:document.documentElement.scrollWidth>innerWidth,cards:[...document.querySelectorAll('.im-choice-grid .im-card')].map(c=>{const q=c.querySelector('.imx-copy'),r=c.getBoundingClientRect();return {left:r.left,right:r.right,font:getComputedStyle(q).fontSize,text:q.textContent};})}));assert.equal(measure.overflow,false);assert.ok(measure.cards.every(c=>c.left>=-1&&c.right<=width+1));assert.ok(measure.cards.every(c=>parseFloat(c.font)>=13));if(name==='portrait')assert.equal(measure.layout,'portrait');await page.screenshot({path:out+'/player-touch-node-'+name+'.png'});result.checks.push({name,...measure});console.log(name+' passed');await context.close();}}
catch(e){result.failure=String((e as Error).stack??e);process.exitCode=1;result.last=await page?.evaluate(()=>({text:document.body.innerText.slice(-1000),layout:document.querySelector('#overlay')?.outerHTML.slice(0,400)})).catch(()=>null);await page?.screenshot({path:out+'/node-layout-failure.png'}).catch(()=>{});}finally{await browser.close();await fs.writeFile(out+'/node-layout-result.json',JSON.stringify(result,null,2));console.log(JSON.stringify({checks:result.checks.length,errors:result.errors,failure:result.failure}));}
