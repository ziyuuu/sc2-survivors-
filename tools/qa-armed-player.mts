 const result=await page.evaluate(()=>{const w=window.__SC2_DEBUG__.world;w.paused=true;const p=w.freePosition('roach',{x:w.anchor.x,z:w.anchor.z+7},1,3);if(!p)throw Error('No fixture threat space');const e=w.addUnit('roach','zerg',p.x,p.z);e.hp=e.maxHp=100000;e.moveSpeed=e.weaponDamage=0;w.hash.rebuild(w.entities.values());w.paused=false;for(let i=0;i<160&&!w.allies().some(u=>u.armed?.cardId==='W01');i++)w.advance(.05);w.paused=true;return {stage:w.stage,deployments:w.expedition.support.armed.deployments.map(d=>({card:d.cardId,phase:d.phase})),troops:w.allies().filter(u=>u.armed).map(u=>({card:u.armed.cardId,rank:u.rank,temporary:u.temporary}))};});assert.ok(result.troops.some(u=>u.card==='W01'&&u.temporary));report.checks.push({nextBattle:result});await page.screenshot({path:out+'/player-next-battle.png'});
