 await page.setViewportSize({width:1440,height:900});await page.locator('[data-action=armed-node]').first().click();await page.waitForTimeout(400);assert.equal((await state()).ranks[node],1);assert.equal((await state()).build.main,'armed');
 await page.locator('[data-action=settings]:visible').first().click();await page.locator('[data-action=settings-tab][data-tab=saves]').click();await page.locator('[data-action=save-now]').click();await page.waitForFunction(()=>window.__SC2_REPORT__().save.message.includes('已保存')&&!window.__SC2_REPORT__().save.busy);const saved=await state();report.checks.push({purpleClaim:node,main:saved.build.main,progress:saved.build.counts.armed,saved:true});
