 page=await browser.newPage({viewport:{width:1440,height:900},acceptDownloads:true});page.on('pageerror',(e:any)=>report.errors.push(e.message));page.on('response',(r:any)=>{if(r.status()>=400)report.errors.push(r.status()+' '+r.url());});
