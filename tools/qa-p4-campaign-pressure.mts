for(const race of ['terran','zerg','protoss']as Race[]){const checkpoints:any[]=[];const r=survive(race,'original',89241,'v7',18,(stage,archive)=>{if([1,6,12,18].includes(stage)){const file=dir+'/natural-'+race+'-'+stage+'.json';checkpoints.push({stage,file,archive});}});for(const c of checkpoints)await fs.writeFile(c.file,c.archive);report.natural.push({...r,checkpoints:checkpoints.map(({stage,file})=>({stage,file}))});await fs.writeFile(dir+'/campaign-pressure.json',JSON.stringify(report,null,2));console.log(JSON.stringify({race,completed:r.completed,phase:r.phase,stage:r.stage,seconds:r.seconds,issue:r.issue}));
 const w=new World({race,sandbox:true,waves:false,terrain:false,obstacles:[],seed:10607});w.start();w.stage=16;setDiagnosticHealthLock(w,true);w.wallet={minerals:0,gas:0};for(const p of Object.values(w.expedition.production))p.enabled={};for(const [j,f]of FAMILIES_BY_RACE[race].slice(0,5).entries())for(let i=0;i<5;i++)w.addUnit(f,'terran',w.anchor.x+j,w.anchor.z+i,5);for(let i=0;i<300;i++){const a=i*2.399,r=5+Math.floor(i/30);w.addUnit(i%10===0?'baneling':i%3===0?'roach':'zergling','zerg',w.anchor.x+Math.sin(a)*r,w.anchor.z+Math.cos(a)*r);}
 for(const id of ['mines','bombardment','mutation','strategic',...Object.entries(UNIQUE_SUPPORT).filter(([,d])=>d.race===race).map(([id])=>id)]as SupportCard[])for(let i=0;i<3;i++)buySupport(w,id);w.castTactical(race==='protoss'?{x:w.anchor.x+10,z:w.anchor.z}:undefined);const ms=[];for(let i=0;i<600;i++){const t=performance.now();w.step();ms.push(performance.now()-t);}ms.sort((a,b)=>a-b);const copy=new World({race,sandbox:true,waves:false,terrain:false,obstacles:[]});copy.restoreRun(w.captureRun());report.pressure.push({race,initialEnemies:300,diagnosticHealthLock:true,steps:600,p95StepMs:ms[Math.floor(ms.length*.95)],p99StepMs:ms[Math.floor(ms.length*.99)],maxStepMs:ms.at(-1),kills:w.stats.kills,entities:w.entities.size,finite:[...w.entities.values()].every(u=>[u.hp,u.x,u.z].every(Number.isFinite)),snapshotValidated:true});await fs.writeFile(dir+'/campaign-pressure.json',JSON.stringify(report,null,2));
