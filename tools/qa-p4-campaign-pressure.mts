import fs from 'node:fs/promises';import {survive} from './qa-p4-natural-controller.mts';import {World} from '../src/simulation/world';import {buySupport,type SupportCard} from '../src/simulation/combat/shop-support';import {UNIQUE_SUPPORT} from '../src/data/unique-support';import {FAMILIES_BY_RACE,type Race} from '../src/data/races';import {setDiagnosticHealthLock} from '../src/diagnostics/combat-lock';
