const out='reports/local/p5-backend-20261006/offline';await fs.mkdir(out,{recursive:true});
const offline=true,fixtures=[];
for(const race of ['terran','zerg','protoss'] as Race[])for(let group=0;group<2;group++){
 if(offline&&(race!=='terran'||group))continue;
 const w=new World({race,seed:10607,waves:false,terrain:campaignTerrain(chooseCampaignMap(10607))});w.start();w.entities.clear();w.heroes.clear();w.pods=[];w.expedition.ledger=[];w.expedition.zerglingPairs=[];w.hive=null;w.expansionHives.clear();w.economicTargets.clear();w.fortifications.clear();w.pickups=[];w.rewardDrops=[];w.time=10;w.tick=600;w.wallet={minerals:10000,gas:10000};for(const p of Object.values(w.expedition.production))p.enabled={};
