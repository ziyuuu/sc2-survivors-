const context=await browser.newContext({viewport:{width:1440,height:900},hasTouch:true}),page=await context.newPage();await context.addInitScript('window.__name=(value)=>value;');
await context.addInitScript(()=>{(window as any).__LIGHTING_INPUT_EVENTS=[];for(const type of ['pointerdown','pointerup','pointercancel','gotpointercapture','lostpointercapture'])addEventListener(type,(event)=>{const e=event as PointerEvent;if(!(e.target instanceof Element)||!e.target.closest('#minimap'))return;const report=(window as any).__SC2_REPORT__?.();(window as any).__LIGHTING_INPUT_EVENTS.push({type,stamp:e.timeStamp,now:performance.now(),pointerType:e.pointerType,pointerId:e.pointerId,primary:e.isPrimary,x:e.clientX,y:e.clientY,target:e.target.id,phase:report?.phase,time:report?.time,order:report?.order,controls:report?.controls});},true);});page.setDefaultTimeout(120000);
