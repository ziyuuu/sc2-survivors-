  await elapsed(2.1);const finished=await snapshot(method==='gamepad');assert.equal(finished.state.talentTransferPlan,null);assert.ok(finished.state.airliftReady>finished.state.time);assert.ok(distance(finished.state.entities.get(prepared.state.talentTransferPlan.participants[0].id),origin)>2);await screenshot(method+'-finished');report.records.push({method,prepared:prepared.state.talentTransferPlan,finishedCooldown:finished.state.airliftReady,gamepad:(await read()).gamepad,simulatedController:method==='gamepad'});await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));
 }
 assert.deepEqual(report.errors,[]);assert.deepEqual(report.requests,[]);report.passed=true;
