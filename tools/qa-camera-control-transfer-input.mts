finally{report.final=await read().catch(()=>null);await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));await context.close();await browser.close();await new Promise<void>(r=>server.close(()=>r()));console.log(JSON.stringify({passed:report.passed,records:report.records.length,screens:report.screens.length,errors:report.errors,failure:report.failure}));}
