import type {Page} from '@playwright/test';import assert from 'node:assert/strict';import path from 'node:path';

/** Separate from fixed-quality timings; real settings, real asynchronous GPU
 * timer, a live dense scene, a light opening scene, pause and context restore. */
export async function checkAdaptive(page:Page,root:string){
 const report:any={method:'Separate adaptive-quality validation; diagnostic clock frozen, native draw pipeline and actual GPU timer. No fixed-quality performance sample includes adaptive frames.',checks:[],samples:[]};
 const shot=(name:string)=>page.screenshot({path:path.join(root,name+'.png')});
 const state=()=>page.evaluate(()=>{const a=(window as any).__DIFFICULTY_R2__,w=a.world;return {time:w.time,tick:w.tick,rng:w.rngState,entities:[...w.entities],flights:w.weaponFlights,effects:w.effects,queue:w.ambientBacklog};});
 const read=()=>page.evaluate(()=>{const a=(window as any).__DIFFICULTY_R2__;return {at:performance.now(),quality:a.view.quality,adaptive:a.view.adaptiveQuality,resolution:a.view.report().resolution,camera:a.view.report().camera,source:a.view.sourceCombatEffects.report(),frame:a.frames.at(-1)};});
 const settings=async()=>{await page.locator('#topbar [data-action=pause]').click();await page.locator('.pause-actions [data-action=settings]').click();await page.locator('[data-action=settings-tab][data-tab=graphics]').click();};
 const resume=async()=>{await page.locator('[data-action=settings-back]').last().click();await page.locator('.pause-actions [data-action=pause]').click();};
 await page.evaluate(()=>{const a=(window as any).__DIFFICULTY_R2__;a.freeze();a.world.paused=false;a.hud.update();});const before=await state();report.fixed=await read();
 await settings();report.options=await page.locator('[data-setting=quality] option').allTextContents();assert.ok(report.options.includes('自适应'));await page.locator('[data-setting=quality]').selectOption('adaptive');assert.equal(await page.evaluate(()=>localStorage.getItem('sc2.renderQuality')),'adaptive');await shot('adaptive-settings');await resume();
 for(let i=0;i<10;i++){await page.waitForTimeout(2500);report.samples.push(await read());console.log('Adaptive dense '+JSON.stringify(report.samples.at(-1).adaptive));}
 report.dense=await read();assert.equal(report.dense.quality,'adaptive');assert.ok(report.dense.adaptive.scale>=.75&&report.dense.adaptive.scale<=1);if(report.dense.adaptive.supported&&report.dense.adaptive.gpuMs>18)assert.ok(report.dense.adaptive.scale<1);assert.deepEqual(await state(),before);await shot('adaptive-dense');report.checks.push('native graphics setting is named 自适应 and persists; GPU-driven dense adjustment preserves simulation');
 await page.locator('#topbar [data-action=pause]').click();const paused=await read();await page.waitForTimeout(3000);assert.equal((await read()).adaptive.scale,paused.adaptive.scale);assert.deepEqual(await state(),before);await page.locator('.pause-actions [data-action=pause]').click();report.checks.push('pause retains resolution and native time without accumulating pressure');
 // Use an actual low-density stage, retaining the controller's current scale.
 await page.evaluate(async()=>{const a=(window as any).__DIFFICULTY_R2__;await a.jump(1,'normal');a.advance(180);});
 for(let i=0;i<10;i++){await page.waitForTimeout(4000);const r=await read();report.samples.push(r);console.log('Adaptive opening '+JSON.stringify(r.adaptive));}
 report.opening=await read();await shot('adaptive-opening');if(report.dense.adaptive.scale<1&&report.opening.adaptive.gpuMs<11.5)assert.ok(report.opening.adaptive.scale>report.dense.adaptive.scale);report.checks.push('native low-density opening exercises slow recovery separately from dense timings');
 await settings();await page.locator('[data-setting=quality]').selectOption('native');await resume();report.returned=await read();assert.equal(report.returned.resolution.renderPixelRatio,report.fixed.resolution.renderPixelRatio);assert.equal(report.returned.resolution.width,report.fixed.resolution.width);await shot('fixed-restored');report.checks.push('returning to fixed clear quality restores the full drawing buffer');
 const stable=await state();await page.evaluate(()=>{const a=(window as any).__DIFFICULTY_R2__,ext=a.view.renderer.getContext().getExtension('WEBGL_lose_context');if(!ext)throw Error('Missing context-loss extension');(window as any).__PERF_CONTEXT__=ext;ext.loseContext();});await page.waitForFunction(()=>(window as any).__DIFFICULTY_R2__.view.renderer.getContext().isContextLost());await page.evaluate(()=>(window as any).__PERF_CONTEXT__.restoreContext());
 for(let i=0;i<20;i++){try{await page.waitForFunction(()=>{const a=(window as any).__DIFFICULTY_R2__;return !a.view.renderer.getContext().isContextLost()&&!a.readiness.state.kind&&!a.view.assetsPending;},null,{timeout:15000});break;}catch{console.log('Adaptive context preparation '+i);}}
 assert.deepEqual(await state(),stable);report.context=await read();await shot('context-restored');report.checks.push('actual WebGL loss and native re-preparation retain time, RNG, entities, flights and queued births');
 for(const size of [{width:960,height:540},{width:390,height:844},{width:1440,height:900}]){await page.setViewportSize(size);await page.waitForFunction(s=>{const r=(window as any).__DIFFICULTY_R2__.view.report().resolution;return r.cssWidth===s.width&&r.cssHeight===s.height;},size);await shot('viewport-'+size.width);}
 report.checks.push('three native viewport sizes render after restoration');return report;
}
export async function checkNakedOpening(page:Page,root:string,folder:string){
 await page.goto(`http://127.0.0.1:4411/${folder}/?gear=0&qa=1&map=mar-sara`);await page.waitForFunction(()=>!!(window as any).__DIFFICULTY_R2__,null,{timeout:180000});
 for(const selector of ['[data-action=menu-new]','[data-action=menu-race][data-race=terran]','[data-action=menu-race-next]','[data-action=menu-difficulty-next]','[data-action=menu-start]'])await page.locator(selector).click();
 for(let i=0;i<25;i++){try{await page.waitForFunction(()=>['ready','error'].includes((window as any).__DIFFICULTY_R2__.readiness.state.phase),null,{timeout:15000});break;}catch{console.log('Naked opening preparation '+i);}}
 await page.locator('[data-action=flow-continue]').click();await page.waitForFunction(()=>(window as any).__DIFFICULTY_R2__.world.phase==='battle');
 await page.locator('#topbar [data-action=pause]').click();await page.locator('.pause-actions [data-action=settings]').click();await page.locator('[data-action=settings-tab][data-tab=controls]').click();await page.locator('[data-setting=desktop]').selectOption('keyboard');await page.locator('[data-action=settings-back]').last().click();await page.locator('.pause-actions [data-action=pause]').click();
 await page.evaluate(()=>(window as any).__DIFFICULTY_R2__.play());const start=await page.evaluate(()=>{const a=(window as any).__DIFFICULTY_R2__;return {at:performance.now(),time:a.world.time,x:a.world.anchor.x,items:Object.keys(a.account.items).length,summary:a.summary()};});assert.equal(start.items,0);assert.equal(start.summary.diagnostic,false);assert.equal(start.summary.difficulty,'normal');
 await page.locator('#battle').focus();await page.keyboard.down('d');await page.waitForTimeout(800);await page.keyboard.up('d');const moved=await page.evaluate(()=>(window as any).__DIFFICULTY_R2__.world.anchor.x);assert.ok(moved>start.x);await page.waitForTimeout(20000);await page.evaluate(()=>(window as any).__DIFFICULTY_R2__.freeze());const end=await page.evaluate(()=>({at:performance.now(),summary:(window as any).__DIFFICULTY_R2__.summary()}));await page.screenshot({path:path.join(root,'normal-naked-native.png')});assert.ok(end.summary.time>start.time);assert.equal(end.summary.diagnostic,false);return {start,end,moved,method:'Actual native normal menu entry with zero equipment and browser keyboard movement; short wall-clock smoke test, not a three-stage human playthrough.'};
}
