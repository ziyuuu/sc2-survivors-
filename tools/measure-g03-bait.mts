import fs from 'node:fs';import assert from 'node:assert/strict';
import {BASE,newCase,startMeasuredCase,economyController,observeEconomy,round} from './lib/g03-economy-runtime.mts';
import {funShopCandidates} from '../src/simulation/fun-shop/state';
const out=BASE+'/bait-r3';fs.mkdirSync(out,{recursive:true});const args=new Map(process.argv.slice(2).map(v=>v.replace(/^--/,'').split('=')));
const difficulties=(args.get('difficulty')??'easy,normal,hard,hell').split(','),seeds=(args.get('seed')??'529,20261023,20261024').split(',').map(Number),rows:any[]=[];
for(const difficulty of difficulties)for(const stage of [6,12,18])for(const seed of seeds)for(const level of [0,1,2,3]){
 const id=[difficulty,stage,seed,level].join('-'),file=out+'/'+id+'.json';if(fs.existsSync(file)){rows.push(JSON.parse(fs.readFileSync(file,'utf8')).summary);continue;}
 const {w,r,a}=await newCase({version:'current',race:'terran',difficulty,quality:3,seed});const sessionIdentity=startMeasuredCase(w,seed);
 // Explicit matched starting fixture. No live battle state or rule is overridden after the start below.
 w.stage=stage-1;w.prepareStage();w.entities.clear();w.pods=[];w.expedition.ledger=[];w.expedition.familySlots=['marine','marauder','reaper','viking','medivac'];
 w.grantFacility('factory');w.grantFacility('starport');for(const f of ['reaper','marauder','science_vessel','viking'])w.expedition.tech['unlock.'+f]=1;
 const rank=stage===6?3:stage===12?5:7,roster=['marine','marine','marine','marine','marauder','marauder','reaper','reaper','viking','medivac'];
 for(const [i,type] of roster.entries())w.addUnit(type,'terran',w.anchor.x+(i%4-1.5)*1.4,w.anchor.z+Math.floor(i/4)*1.4,rank);
 w.stageElapsed=w.duration;w.endStage();assert.equal(w.phase,'reward');assert.ok(w.skipDevelopment());w.wallet={minerals:1000,gas:500};
 const observer=observeEconomy(w),controller=economyController(w,r,'terran');const before={...w.wallet};let receipt:any=null;
 if(level){const c=funShopCandidates(w.funShop.levels,difficulty as any).find(c=>c.item==='bait'&&c.level===level)!;assert.ok(c);const offer={id:c.id,offerId:'bait-measurement:'+id,name:c.name,description:c.description,icon:c.icon,rarity:c.rarity,kind:'buff',value:c.item,...c.price,baseMinerals:c.price.minerals,baseGas:c.price.gas,discount:0,sold:false,expeditionWindow:w.draftWindowId,expeditionRound:'random',expeditionEffect:{kind:'funShop',item:'bait',level,expected:0}};w.rewards=[offer];assert.ok(w.purchaseShopOffer(w.draftWindowKey,offer.offerId,w.expedition.shopRevision));receipt={price:c.price,paid:{minerals:before.minerals-w.wallet.minerals,gas:before.gas-w.wallet.gas}};assert.deepEqual(receipt.paid,c.price);}
 controller.configure();assert.ok(w.finishIntermission());assert.equal(w.stage,stage);observer.sample('fixture-start');
 let nextThink=0,nextSample=5,steps=0,peakEnemies=0;const started=Date.now();
 while((w.phase==='battle'||w.specialStages.active)&&steps<20000&&Date.now()-started<120000){controller.decisions();if(w.phase!=='battle')break;if(w.time>=nextThink){nextThink=w.time+.25;controller.think();}w.step();steps++;peakEnemies=Math.max(peakEnemies,w.enemyCount());if(steps%15===0)observer.inspect();if(w.time>=nextSample){nextSample=w.time+5;observer.sample();}}
 observer.sample('final');const measurement=observer.finish(),summary={id,sessionIdentity,difficulty,stage,seed,level,rank,roster,steps,seconds:round(w.time),stageSeconds:round(w.stageElapsed),phase:w.phase,stop:steps>=20000||Date.now()-started>=120000?'censored':w.phase,price:receipt?.paid??{minerals:0,gas:0},fixtureWallet:before,wallet:{...w.wallet},bait:structuredClone(w.funShop.bait),allies:w.allies().length,kills:w.stats.kills,peakEnemies,itemsGenerated:measurement.items.length,itemsCollected:measurement.items.filter((i:any)=>i.collected).length,reconciliation:measurement.reconciliation,wallMs:Date.now()-started};
 assert.ok(Object.values(measurement.reconciliation).every((n:any)=>Math.abs(n)<.00001));
 fs.writeFileSync(file,JSON.stringify({summary,method:'Conditional native single-stage battle, with controlled blue equipment, ten-body roster, rank3/5/7 and prerequisites, fixed 1000/500 preparation budget before the real shop debit. The chosen bait offer is injected only to guarantee the tested purchase opportunity, not to represent natural shelf frequency. Native paid transaction, campaign map/waves/events/damage/production and public-action policy remain active afterward. No guaranteed bait outcome, HP lock, RNG override or forced rewards. Pairing shares initial state, World/equipment seed and native session UUID input (receipt-seeded rewards stay native); later RNG and battles diverge. The one-stage marginal result is not full-lifetime item return.',measurement,policyEvents:[...controller.base.events,...controller.events]},null,2));rows.push(summary);fs.writeFileSync(out+'/summary-'+difficulties.join('-')+'.json',JSON.stringify({rows},null,2));console.log(JSON.stringify(summary));
}
