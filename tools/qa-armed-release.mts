try{page=await browser.newPage({viewport:{width:1440,height:900},acceptDownloads:true});page.on('pageerror',(e:any)=>result.errors.push(e.message));page.on('response',(r:any)=>{if(r.status()>=400)result.errors.push(r.status()+' '+r.url());});await page.goto(base+'/',{timeout:180000});await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu');assert.equal(await page.evaluate(()=>typeof window.__SC2_DEBUG__),'undefined');assert.equal(await page.locator('meta[name=sc2-app-build]').getAttribute('content'),release.appBuildId);
 for(const {id}of JSON.parse(await fs.readFile('deploy/runtime/armed-support-assets.json','utf8')).records){const row=manifest.assets[id];assert.ok(row,id);const response=await page.request.get(base+'/'+row.url),bytes=await response.body();assert.equal(response.status(),200);assert.equal(createHash('sha256').update(bytes).digest('hex'),row.sha256);result.checks.push({asset:id,hashVerified:true});}
 await page.locator('[data-action=settings]:visible').first().click();await page.locator('[data-action=settings-tab][data-tab=saves]').click();const chooser=page.waitForEvent('filechooser');await page.locator('[data-action=menu-load-file]').click();await(await chooser).setFiles(path.resolve(out+'/player-start.json'));await ready();await page.locator('[data-action=flow-continue]').click();const fixture=readArchive(await fs.readFile(out+'/player-start.json','utf8')).bundle.run!,offer=fixture.state.rewards.find((r:any)=>r.expeditionEffect?.cardId==='W01')!;
 await page.locator(`[data-action=reward][data-id="${offer.offerId}"]`).click();await page.waitForTimeout(400);await page.locator('[data-action=settings]:visible').first().click();await page.locator('[data-action=settings-tab][data-tab=saves]').click();await page.locator('[data-action=save-now]').click();await page.waitForFunction(()=>!window.__SC2_REPORT__().save.busy&&window.__SC2_REPORT__().save.message.includes('已保存'));const saved=await exported();assert.equal(saved.state.expedition.support.armed.ranks.W01,1);assert.equal(saved.state.expedition.build.counts.armed,1);result.checks.push({purchase:'W01',progress:1,save:true});
 await page.reload({timeout:180000});await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu');await page.locator('.main-actions [data-action=save-continue]').click();await ready();await page.locator('[data-action=flow-continue]').click();await page.locator('[data-action=settings]:visible').first().click();await page.locator('[data-action=settings-tab][data-tab=saves]').click();const restored=await exported();assert.deepEqual(restored.state.expedition.support.armed,saved.state.expedition.support.armed);assert.deepEqual(restored.state.expedition.build,saved.state.expedition.build);assert.deepEqual(restored.state.wallet,saved.state.wallet);await page.locator('[data-action=settings-back]').last().click();await page.locator('[data-action=skip]').click();await page.waitForFunction(()=>window.__SC2_REPORT__().phase==='battle');const last=await page.evaluate(()=>window.__SC2_REPORT__());assert.equal(last.stage,2);assert.deepEqual(last.errors,[]);result.checks.push({checkpointRestored:true,nextStage:2,noDebugAPI:true});await page.screenshot({path:out+'/packaged-player-stage2.png'});assert.deepEqual(result.errors,[]);
}catch(e){result.failure=String((e as Error).stack??e);process.exitCode=1;result.last=await page?.evaluate(()=>({phase:window.__SC2_REPORT__?.().phase,ready:window.__SC2_REPORT__?.().readiness,text:document.body.innerText.slice(-800)})).catch(()=>null);}finally{await browser.close();await new Promise<void>(r=>server.close(()=>r()));await fs.writeFile(out+'/release-player.json',JSON.stringify(result,null,2));console.log(JSON.stringify({checks:result.checks.length,errors:result.errors,failure:result.failure}));}
