import {chromium} from '@playwright/test';
import {createGameServer} from './coze-web-server.mjs';
import {readArchive} from '../src/persistence/archive';
const out=process.env.ARMED_QA_OUT??'reports/local/armed-support-design-20261111',root=path.resolve(process.env.ARMED_RELEASE_ROOT??'dist/armed-support-20261111-candidate/web'),release=JSON.parse(await fs.readFile(root+'/web-release.json','utf8')),manifest=JSON.parse(await fs.readFile(root+'/'+release.manifest,'utf8'));
const server=createGameServer({webRoot:root,assetRoot:root});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const base='http://127.0.0.1:'+(server.address() as any).port;
const result:any={appBuildId:release.appBuildId,assetRelease:release.release,scope:'Isolated packaged production main entry; no debug API. Engineering checkpoint via real import, card purchase, actual IndexedDB reload/continue and next-stage UI. No public deployment.',checks:[],errors:[]};let page:any;
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,args:['--no-proxy-server']});
const ready=async()=>{await page.waitForFunction(()=>{const r=window.__SC2_REPORT__?.();return ['ready','error'].includes(r?.readiness?.phase)||r?.phase==='battle'&&!r.readiness.kind&&r.assetsReady;},null,{timeout:180000});const r=await page.evaluate(()=>window.__SC2_REPORT__());assert.notEqual(r.readiness.phase,'error');};
