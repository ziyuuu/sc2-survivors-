<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="V01 local diagnostics">
  <Profiles>
    <SystemCollector Id="V01System" Name="V01 Spike Scheduling">
      <BufferSize Value="64"/>
      <Buffers Value="1024"/>
    </SystemCollector>
    <SystemProvider Id="V01Provider">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="ProcessFreeze"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
        <Keyword Value="HardFaults"/>
        <Keyword Value="DiskIO"/>
        <Keyword Value="DiskIOInit"/>
        <Keyword Value="Filename"/>
      </Keywords>
      <Stacks><Stack Value="HardFault"/><Stack Value="CSwitch"/></Stacks>
    </SystemProvider>
    <Profile Id="V01Scheduling.Light.Memory" Name="V01Scheduling" Description="Bounded kernel scheduling and page-in evidence; no sampled CPU profiling" LoggingMode="Memory" DetailLevel="Light">
      <Collectors><SystemCollectorId Value="V01System"><SystemProviderId Value="V01Provider"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
