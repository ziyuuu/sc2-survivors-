import fs from 'node:fs/promises';import {createHash} from 'node:crypto';
import {World} from '../src/simulation/world';import {campaignTerrain,chooseCampaignMap} from '../src/data/campaign-map';import {readArchive,writeArchive} from '../src/persistence/archive';
const out='reports/local/ui-fidelity-round-20261006/fixtures';await fs.mkdir(out,{recursive:true});const rows=[];
for(const name of ['terran-battle','terran-development','terran-shop','zerg-battle','zerg-development','zerg-shop','protoss-battle','protoss-development','protoss-shop','won','endless']){const source='reports/local/ui-fidelity-audit-20261006/fixtures/'+name+'.json',raw=await fs.readFile(source,'utf8'),b=readArchive(raw).bundle,r=b.run!,w=new World({race:r.config.race,terrain:campaignTerrain(r.config.campaignMap!)});w.permanentProfile.importJSON(b.profile);w.restoreRun(r);await fs.writeFile(out+'/'+name+'.json',raw);rows.push({name,source,sha256:createHash('sha256').update(raw).digest('hex'),exactCopy:true,validated:true});}
