 const first=Object.entries(PRODUCTION_LINES).find(([,d])=>d.race===race)!,target=first[1].families[1];w.expedition.developmentTarget='unlock.'+target;for(const p of Object.values(w.expedition.production))p.enabled={};w.endStage();w.setDevelopmentDirection(first[0]as never);
 const file=path.resolve(out,race+'-building.json');await fs.writeFile(file,writeArchive({profile:w.permanentProfile.exportJSON(),run:w.captureRun()}));fixtures[race]=file;
 w.skipReward();for(let n=0;n<200&&!w.rewards.some(r=>(r as any).expeditionEffect.kind==='teamCard');n++)w.reroll();w.wallet={minerals:0,gas:0};const poor=path.resolve(out,race+'-poor.json');await fs.writeFile(poor,writeArchive({profile:w.permanentProfile.exportJSON(),run:w.captureRun()}));fixtures[race+'-poor']=poor;
}
const arrival=new World({seed:100927,waves:false,terrain:campaignTerrain({version:3,seed:100927,theme:'industrial'})});arrival.start();for(const p of Object.values(arrival.expedition.production))p.enabled={};for(const isHero of [false,true]){arrival.random=()=>isHero?.1:.5;const b=arrival.spawnSpecial('zergling','boss',arrival.anchor)!;arrival.hit(b,1e9,[],1,'terran');}for(const d of arrival.rewardDrops)if(d.bossLootReceipt&&(d.reward as any).expeditionEffect.kind==='elite')d.bossLootVariant='marine.2';arrival.paused=true;fixtures.arrival=path.resolve(out,'arrival.json');await fs.writeFile(fixtures.arrival,writeArchive({profile:arrival.permanentProfile.exportJSON(),run:arrival.captureRun()}));
const server=createGameServer({webRoot:path.resolve('dist/web'),assetRoot:path.resolve('dist/web'),backendOptions:{enabled:false}});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const url='http://127.0.0.1:'+(server.address()as any).port;
