import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';
import {growthRuntime,OUT,ROOT} from './lib/g03-growth-runtime.mts';import {gearFor} from './lib/g03-growth-cases.mts';
const plan=JSON.parse(fs.readFileSync(OUT+'/plan.json','utf8')),before=await growthRuntime('before'),after=await growthRuntime('after'),rows:any[]=[],pairs=new Map();
for(const c of plan.cases){const r=c.version==='before'?before:after,{a,spec}=gearFor(r,c),items=Object.values(a.items) as any[];assert.equal(items.length,12);assert.ok(items.every(i=>r.validateItem(i)));assert.ok(items.every(i=>i.pollution!=='uncleansed'));const hash=createHash('sha256').update(JSON.stringify(a)).digest('hex'),key=[c.race,c.difficulty,c.tier,c.seed].join('-');if(pairs.has(key))assert.equal(hash,pairs.get(key),key+' identical opening account across value/policy arms');else pairs.set(key,hash);rows.push({...c,spec,items:items.map(i=>({id:i.id,template:i.template,slot:i.slot,quality:i.quality,pollution:i.pollution,binding:i.binding,allocation:i.allocation,affixes:i.affixes})),accountSha256:hash});}
const white=[];for(const quality of [2,3,4,5])for(const pollution of ['none','cleansed']){if(pollution==='cleansed'&&quality!==5)continue;white.push({quality,pollution,offenseBefore:before.whiteValues(quality,'offense1',2,pollution),offenseAfter:after.whiteValues(quality,'offense1',2,pollution),defenseBefore:before.whiteValues(quality,'defense1',2,pollution),defenseAfter:after.whiteValues(quality,'defense1',2,pollution)});}
const identity=[];for(const kind of ['ordinary','elite','hero'])for(const rank of [1,2,3,5,9]){const u={rank,...(kind==='hero'?{heroId:'raynor'}:kind==='elite'?{eliteId:'marine.1'}:{})};assert.deepEqual(before.identityFactors(u),after.identityFactors(u));identity.push({kind,rank,nativeIdentityFactors:after.identityFactors(u),newHighQualityExtra:after.rankEquipmentBonus(u)});}
const sha=(p:string)=>createHash('sha256').update(fs.readFileSync(p)).digest('hex'),baseline=JSON.parse(fs.readFileSync(OUT+'/before.json','utf8')),current=baseline.current;assert.equal(sha(ROOT+'/'+current.file),current.sha256);
fs.writeFileSync(OUT+'/inputs-and-values.json',JSON.stringify({cases:rows.length,items:rows.length*12,pairOpeningAccountsExact:true,rows,white,identity,current,scope:'Item legality and equal prepared opening accounts, not acquisition-time evidence. Native identity factors remain byte-for-byte behavior-equivalent.'},null,2));console.log(JSON.stringify({cases:rows.length,legalItems:rows.length*12,openingPairsExact:true,identityRows:identity.length,currentExact:true}));
