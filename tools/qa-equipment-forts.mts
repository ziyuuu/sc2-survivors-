import {chromium} from '@playwright/test';import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
const folder=process.env.SC2_PREVIEW_NAME??'equipment-effects-r5-20261016',root=path.resolve(process.env.SC2_QA_DIR??'reports/local/equipment-fx-performance-20261016/forts-r1');await fs.mkdir(root,{recursive:true});
const report:any={started:new Date().toISOString(),method:'Legal pre-run four-piece fortification set; native deployment, shots and actual hit/death; deliberate static targets/time steps. Not natural gameplay.',build:JSON.parse(await fs.readFile('preview/'+folder+'/build-inputs.json','utf8')),cases:[],errors:[]};
const context=await chromium.launchPersistentContext(path.join(root,'profile'),{executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,viewport:{width:1440,height:900},deviceScaleFactor:1}),page=context.pages()[0];
page.on('pageerror',e=>report.errors.push(e.message));page.on('console',m=>{if(m.type()==='error')report.errors.push(m.text());});await page.addInitScript('window.__name=v=>v;localStorage.setItem("sc2.renderQuality","native");localStorage.setItem("sc2.animationMode","complete");localStorage.setItem("sc2.heroEffects","full");localStorage.setItem("sc2.ordinaryEffects","full");');
const save=()=>fs.writeFile(path.join(root,'report.json'),JSON.stringify(report,null,2));
try{await page.goto('http://127.0.0.1:4413/'+folder+'/?qa=1',{timeout:120000});await page.waitForFunction(()=>!!(window as any).__EQUIPMENT_EFFECTS__,null,{timeout:180000});
 for(const race of ['terran','zerg','protoss']){console.log('Preparing '+race);const live=await page.evaluate(async race=>(window as any).__EQUIPMENT_EFFECTS__.fortFixture(race),race);assert.equal(live.forts.length,5);assert.ok(live.receipts.some((e:any)=>e.kind==='fort-shot'&&e.detail==='turret_'+race));await fs.writeFile(path.join(root,race+'-live.json'),JSON.stringify(live));await page.screenshot({path:path.join(root,race+'-live.png')});const dead=await page.evaluate(()=>(window as any).__EQUIPMENT_EFFECTS__.fortDeath());assert.equal(dead.receipts.filter((e:any)=>e.kind==='fort-end').length,5);await fs.writeFile(path.join(root,race+'-dead.json'),JSON.stringify(dead));await page.screenshot({path:path.join(root,race+'-dead.png')});report.cases.push({race,passed:true,shots:live.receipts.filter((e:any)=>e.kind==='fort-shot').length});await save();}
 assert.deepEqual(report.errors,[]);report.passed=true;
}catch(error){report.failure=String(error instanceof Error?error.stack:error);process.exitCode=1;}finally{report.finished=new Date().toISOString();await save();await context.close();console.log(JSON.stringify({passed:report.passed,failure:report.failure,cases:report.cases.length,errors:report.errors.length}));}
