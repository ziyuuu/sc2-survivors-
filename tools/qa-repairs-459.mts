import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';
import {chromium} from '@playwright/test';
import {World} from '../src/simulation/world';import {campaignTerrain} from '../src/data/campaign-map';
import {writeArchive,readArchive} from '../src/persistence/archive';
import {createGameServer} from './coze-web-server.mjs';
const out=process.env.SC2_459_QA_DIR??'reports/local/repairs-459-20261009/browser';await fs.mkdir(out,{recursive:true});
function world(){const w=new World({seed:10812,waves:false,terrain:campaignTerrain({version:3,seed:10812,theme:'industrial'})});assert.ok(w.start());for(const p of Object.values(w.expedition.production))p.enabled={};w.hive=null;w.expansionHives.clear();w.economicTargets.clear();w.fortifications.clear();return w;}
async function fixture(name:string,kind:'elite'|'hero'|'sequence'|'promotion'|'legacy'){
 const w=world();for(const rarity of kind==='sequence'?['elite','hero']:[kind==='hero'?'hero':'elite']){w.random=()=>rarity==='hero'?.1:.5;const boss=w.spawnSpecial('zergling','boss',{x:w.anchor.x,z:w.anchor.z})!;w.hit(boss,1e9,[],1,'terran');}
 for(const d of w.rewardDrops)if(d.bossLootReceipt&&(d.reward as any).expeditionEffect.kind==='elite')d.bossLootVariant='marine.2';
 if(kind==='promotion')assert.ok(w.acquireElite('marine.2'));
 if(kind==='legacy'){const d=w.rewardDrops.find(d=>d.bossLootReceipt)!;w.rewardDrops=[];w.endStage();w.expedition.bossLootQueue=[{receipt:d.bossLootReceipt!,reward:d.reward as any,variant:'marine.2'}];w.expedition.bossLootOpen=true;}
 w.paused=true;const file=path.resolve(out,name+'.json');await fs.writeFile(file,writeArchive({profile:w.permanentProfile.exportJSON(),run:w.captureRun()}));return file;
}
const files={elite:await fixture('elite','elite'),hero:await fixture('hero','hero'),sequence:await fixture('sequence','sequence'),promotion:await fixture('promotion','promotion'),legacy:await fixture('legacy','legacy')};
const sw=world();sw.wallet={minerals:10000,gas:10000};sw.expedition.developmentTarget='factory';sw.endStage();assert.ok(sw.setDevelopmentDirection('factory'));const building=path.resolve(out,'building.json');await fs.writeFile(building,writeArchive({profile:sw.permanentProfile.exportJSON(),run:sw.captureRun()}));
const server=createGameServer({webRoot:path.resolve('dist/web'),assetRoot:path.resolve('dist/web')});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const url='http://127.0.0.1:'+(server.address()as any).port;
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true,args:['--disable-background-timer-throttling','--disable-renderer-backgrounding']});
const report:any={appBuildId:JSON.parse(await fs.readFile('dist/web/web-release.json','utf8')).appBuildId,checks:[],captures:[],geometry:[],errors:[],method:'Production build with real map diagnostic archives; native pickup and UI actions. Not physical/natural acceptance.'};let page:any;
const shot=async(name:string)=>{const file=out+'/'+name+'.png';await page.screenshot({path:file});report.captures.push(file);};
async function load(file:string){
 const phase=await page.evaluate(()=>window.__SC2_REPORT__?.().phase).catch(()=>null);
 if(phase==='battle'){if(!await page.locator('.pause-actions [data-action=restart]').isVisible())await page.locator('#topbar [data-action=pause]').click();await page.locator('.pause-actions [data-action=restart]').click();}
 else if(phase!=='menu')await page.goto(url,{timeout:240000});
await page.waitForFunction(()=>window.__SC2_REPORT__?.().phase==='menu');await page.locator('.main-actions [data-action=menu-load]').click();const pick=page.waitForEvent('filechooser');await page.locator('[data-action=menu-load-file]').click();await(await pick).setFiles(file);await page.locator('[data-action=menu-load-ready]').click();await page.waitForFunction(()=>window.__SC2_REPORT__?.().readiness?.phase==='ready',null,{timeout:240000});await page.locator('[data-action=flow-continue]').click();if(await page.locator('.pause-actions [data-action=pause]').isVisible())await page.locator('.pause-actions [data-action=pause]').click();}
async function exported(){const download=page.waitForEvent('download');await page.locator('[data-action=save-export]').click();return readArchive(await fs.readFile(await(await download).path(),'utf8')).bundle.run!;}
try{
 for(const [name,width,height,mobile]of [['desktop',1440,900,false],['portrait',390,844,true],['narrow',320,700,true],['landscape',844,390,true]]as const){
  const context=await browser.newContext({viewport:{width,height},hasTouch:mobile,isMobile:mobile,acceptDownloads:true});await context.addInitScript(()=>localStorage.setItem('sc2.controls.v1',JSON.stringify({desktop:'keyboard',touch:'joystick'})));page=await context.newPage();page.on('pageerror',(e:any)=>report.errors.push(e.message));page.on('console',(m:any)=>{if(m.type()==='error')report.errors.push(m.text());});
  await load(files.sequence);await page.locator('.arrival-card.elite').waitFor();
  assert.equal(await page.locator('.arrival-art > [data-art-key]').getAttribute('data-art-key'),'marine.2');
  const geometry=await page.locator('.arrival-body').evaluate((e:HTMLElement)=>[...e.children].map((n:any)=>({width:n.offsetWidth,height:n.offsetHeight,radius:getComputedStyle(n).borderRadius})));assert.deepEqual(geometry[0],geometry[1]);report.geometry.push({name,...geometry[0]});
  const box=await page.locator('.arrival-card').boundingBox();assert.ok(box.x>=0&&box.y>=0&&box.x+box.width<=width&&box.y+box.height<=height);assert.equal(await page.locator('#arrival-layer').evaluate((e:HTMLElement)=>getComputedStyle(e).pointerEvents),'none');
  assert.equal(await page.locator('[data-action^=boss-loot]').count(),0);assert.equal(await page.locator('.arrival-back img').evaluate((e:HTMLImageElement)=>e.complete&&e.naturalWidth>100),true);
  if(!mobile){await page.keyboard.down('d');await page.waitForTimeout(500);await page.keyboard.up('d');}else{const b=await page.locator('#joystick').boundingBox(),cdp=await context.newCDPSession(page);await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x:b.x+b.width/2,y:b.y+b.height/2}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:b.x+b.width/2+28,y:b.y+b.height/2}]});await page.waitForTimeout(500);await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});await cdp.detach();}
  await shot(name+'-elite');await page.locator('.arrival-card.hero').waitFor();await page.waitForTimeout(1100);const artBounds=await page.locator('.arrival-art').boundingBox(),coverBounds=await page.locator('.arrival-art .hero-cover').boundingBox();assert.ok(Math.abs(artBounds.height-coverBounds.height)<3&&coverBounds.y>=artBounds.y);await shot(name+'-hero');assert.ok((await page.evaluate(()=>window.__SC2_REPORT__().time))>1);
  assert.equal(await page.locator('#map-toggle').innerText(),'−');assert.ok(await page.locator('#minimap-canvas').isVisible());await page.locator('.arrival-card').waitFor({state:'detached',timeout:6000});
  await page.locator('#topbar [data-action=pause]').click();const saved=await exported();assert.equal(saved.state.expedition.bossLootQueue.length,0);assert.equal(saved.state.expedition.bossLootClaimed.length,2);assert.equal(saved.state.heroes.size,1);assert.ok([...saved.state.entities.values()].some((u:any)=>u.eliteId==='marine.2'));assert.ok(Math.hypot(saved.state.anchor.x,saved.state.anchor.z)>.1,'Input moves during reveal');report.checks.push(name+': native pickup, two joined units, correct art, same face bounds, queue timeout, live movement, minimap, no claim UI');
  await load(files.promotion);await page.locator('.arrival-card.elite').waitFor();assert.match(await page.locator('.arrival-caption').innerText(),/军衔提升至 Ⅱ/);await page.waitForTimeout(1100);await shot(name+'-promotion');report.checks.push(name+': promotion identity and new rank');
  if(name==='desktop'){
   await load(files.elite);await page.locator('.arrival-card.elite').waitFor();for(const time of [400,700,800,1300]){await page.locator('.arrival-card').evaluate((e:HTMLElement,t:number)=>{for(const a of e.getAnimations({subtree:true})){a.pause();a.currentTime=t;}},time);const bounds=await page.locator('.arrival-body').evaluate((e:HTMLElement)=>[...e.children].map(n=>{const r=n.getBoundingClientRect();return [r.x,r.y,r.width,r.height];}));assert.ok(bounds[0].every((v:number,i:number)=>Math.abs(v-bounds[1][i])<.25));await shot('desktop-phase-'+time);}report.checks.push('Shared R4 front/back projected geometry in four motion phases');
   await load(files.legacy);await page.locator('.arrival-card').waitFor();assert.ok(await page.locator('#overlay').isVisible());assert.ok(await page.evaluate(()=>Number(getComputedStyle(document.getElementById('arrival-layer')!).zIndex)>Number(getComputedStyle(document.getElementById('overlay')!).zIndex)));await page.waitForTimeout(1100);await shot('desktop-legacy-intermission');await page.locator('.arrival-card').waitFor({state:'detached'});report.checks.push('Current-schema pending reward settles and its card remains visible above intermission');
  }
  if(name==='portrait'){
   await page.emulateMedia({reducedMotion:'reduce'});await load(files.elite);await page.locator('.arrival-card.elite').waitFor();assert.equal(await page.locator('.arrival-back').isVisible(),false);assert.equal(await page.locator('.arrival-body').evaluate((e:HTMLElement)=>getComputedStyle(e).animationName),'none');await shot('portrait-reduced-motion');await page.emulateMedia({reducedMotion:'no-preference'});report.checks.push('Reduced motion static card');
  }
  await load(building);assert.equal(await page.locator('[data-page=catalog]').count(),0);const card=page.locator('.im-card').filter({has:page.locator('[data-id]')}).filter({hasText:'重工厂'}).first();await card.waitFor();assert.match(await card.innerText(),/解锁恶火/);await shot(name+'-factory');await card.locator('.im-card-action').click();await page.waitForFunction(()=>window.__SC2_REPORT__().phase==='reward');
  report.checks.push(name+': original factory card shows baseline unlock; no catalogue entry');await context.close();
 }
 assert.deepEqual(report.errors,[]);
}catch(e){report.failure=String((e as Error).stack??e);if(page)await shot('failure').catch(()=>{});throw e;}finally{await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));await browser.close();await new Promise<void>(r=>server.close(()=>r()));}
