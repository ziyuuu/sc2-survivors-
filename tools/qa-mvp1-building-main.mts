import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import {chromium,type Page} from '@playwright/test';
import {createGameServer} from './coze-web-server.mjs';

const out=process.argv[2],web=process.argv.find(a=>a.startsWith('--web='))?.slice(6)??'reports/local/mvp1-building-main-20261013/diagnostic-r1';
if(!out?.startsWith('reports/local/mvp1-building-main-20261013/')||out.includes('..'))throw Error('Unsafe evidence directory');
await fs.access(out).then(()=>{throw Error('Evidence exists');},e=>{if(e.code!=='ENOENT')throw e;});await fs.mkdir(out,{recursive:true});await fs.copyFile(new URL(import.meta.url),out+'/runner.mts');
const build=JSON.parse(await fs.readFile(web+'/web-release.json','utf8'));assert.equal(build.diagnostic,true);
const server=createGameServer({webRoot:path.resolve(web),assetRoot:path.resolve('deploy/runtime'),backendOptions:{config:{enabled:false}}});await new Promise<void>(resolve=>server.listen(0,'127.0.0.1',resolve));
const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true});
const entry='http://127.0.0.1:'+(server.address() as any).port;
const report:any={at:new Date().toISOString(),build,entry,method:'Actual main-game boot, menus, required asset preparation and HUD controls in fresh isolated browser contexts. Wallet and stage-end fixtures use native World calls; no forced carrier arrival, health, combat, clock or renderer transform. Natural transport has separate native tests. Not human, physical-device, performance, balance, save or whole-MVP acceptance.',screens:[],checks:[],fixtures:[],races:[],errors:[],httpErrors:[],consoleErrors:[]};
let page:Page|undefined;
const state=()=>page!.evaluate(()=>{const n=(window as any).__MVP1_NATIVE__,w=n.world;return {runId:w.runId,phase:w.phase,paused:w.paused,round:w.rewardRound,stage:w.stage,time:w.time,tick:w.tick,revision:w.revision,window:w.draftWindowKey,shopRevision:w.expedition.shopRevision,rng:w.rngState,wallet:{...w.wallet},tech:{...w.expedition.tech},groups:structuredClone(w.expedition.building.groups),ledger:structuredClone(w.expedition.ledger),refresh:w.rerollCost(),paidRefresh:w.expedition.refreshCount,offers:structuredClone(w.rewards),profile:w.permanentProfile.exportJSON()};});
async function progress(label:string){const native=await state();report.progress={at:new Date().toISOString(),label,native};await fs.writeFile(out+'/progress.json',JSON.stringify(report.progress,null,2));console.log(label);}
async function snapshot(){return page!.evaluate(()=>JSON.stringify((window as any).__MVP1_NATIVE__.world.captureRun(),(_key,value)=>value instanceof Map?{map:[...value]}:value instanceof Set?{set:[...value]}:value));}
async function shot(label:string){await page!.screenshot({path:out+'/'+label+'.png'});report.screens.push({label,state:await state()});}
async function ready(){await page!.waitForFunction(()=>['ready','error'].includes((window as any).__SC2_REPORT__?.().readiness?.phase),null,{timeout:900000});const r=await page!.evaluate(()=>(window as any).__SC2_REPORT__());assert.equal(r.readiness.phase,'ready',JSON.stringify(r.readiness));assert.equal(r.assetsPending,0);assert.deepEqual(r.errors,[]);assert.equal(r.sourceCombat.source.ready,true);await page!.locator('[data-action="flow-continue"]').click();await page!.waitForFunction(()=>(window as any).__SC2_REPORT__().phase==='battle');if(!(await state()).paused)await page!.locator('#topbar [data-action="pause"]').click();}
async function start(race:string){await page!.goto(entry,{timeout:600000});await page!.waitForFunction(()=>(window as any).__SC2_REPORT__?.().phase==='menu',null,{timeout:900000});await page!.locator('.main-actions [data-action="menu-new"]').click();await page!.locator('[data-action="menu-race"][data-race="'+race+'"]').click();await page!.locator('[data-action="menu-race-next"]').click();await page!.locator('[data-action="menu-difficulty"][data-difficulty="easy"]').click();await page!.locator('[data-action="menu-difficulty-next"]').click();await page!.locator('[data-action="menu-start"]').click();await ready();console.log(race+' native new-run ready');}
async function fixtureWindow(projectId:string,rich=false){
 const before=await state();assert.equal(before.phase,'battle');
 await page!.evaluate(({projectId,rich})=>{const n=(window as any).__MVP1_NATIVE__,w=n.world;if(rich){w.wallet.minerals=10000;w.wallet.gas=10000;}w.expedition.developmentTarget=projectId;w.endStage();n.hud.update();},{projectId,rich});
 const after=await state();assert.equal(after.phase,'reward');assert.equal(after.round,'building');report.fixtures.push({kind:'native-stage-end-and-frozen-project',projectId,rich,before,after});
}
async function direction(line:string){await page!.locator('.im-direction [data-action="development-direction"][data-line="'+line+'"]').click();}
async function card(id:string){const s=await state(),r=s.offers.find((r:any)=>r.expeditionEffect?.definitionId===id);assert.ok(r,'Missing frozen project '+id);return r;}
async function purchase(id:string,target?:number){
 const r=await card(id),before=await state();const action=page!.locator('.im-card-action[data-id="'+r.offerId+'"]');await action.click();
 if(target!==undefined){assert.match(await page!.locator('.im-detail-rule').innerText(),/仅开放所选孵化场/);assert.doesNotMatch(await page!.locator('.im-detail-rule').innerText(),/最高.*级/);await page!.locator('[data-development-target]').selectOption(String(target));await shot(before.groups[0].kind+'-'+id+'-target-'+target);await page!.locator('.im-detail-dialog [data-action="development-purchase"]').click();}
 await page!.waitForFunction(()=>(window as any).__MVP1_NATIVE__.world.rewardRound==='random');const after=await state();assert.equal(after.wallet.minerals,before.wallet.minerals-r.minerals);assert.equal(after.wallet.gas,before.wallet.gas-r.gas);assert.deepEqual(after.ledger,before.ledger);
 const replay=await snapshot();assert.equal(await page!.evaluate(({id,window:windowKey,revision,target})=>(window as any).__MVP1_NATIVE__.world.purchaseDevelopmentOffer(windowKey,id,revision,target),{id:r.offerId,window:before.window,revision:before.shopRevision,target}),false);assert.equal(await snapshot(),replay);
 report.checks.push({kind:'native-pointer-purchase',project:id,target,before,after,replayRejected:true});await page!.waitForTimeout(400);
}
async function nextBattle(){const before=await state();await progress('preparing native next front at stage '+before.stage);await page!.locator('.reward-actions [data-action="skip"]').click();await page!.waitForFunction(()=>{const r=(window as any).__SC2_REPORT__();return r.phase==='battle'&&!r.readiness.kind||r.readiness.phase==='error';},null,{timeout:900000});const r=await page!.evaluate(()=>(window as any).__SC2_REPORT__());assert.equal(r.phase,'battle',JSON.stringify(r.readiness));assert.equal(r.assetsPending,0);assert.equal(r.sourceCombat.source.ready,true);assert.deepEqual(r.errors,[]);const after=await state();assert.equal(after.stage,before.stage+1);if(!after.paused)await page!.locator('#topbar [data-action="pause"]').click();await progress('native next front ready at stage '+after.stage);report.checks.push({kind:'actual-auto-reinforcement-preparation',before,after,runtime:r});}
async function settlePanel(){await page!.locator('.production-modal').evaluate(async el=>{await Promise.all(el.getAnimations({subtree:true}).filter(a=>a.effect?.getTiming().iterations!==Infinity).map(a=>a.finished.catch(()=>{})));});}
async function open(){await page!.locator('.feedback-progress-strip [data-action="battle-base"]').click();assert.equal(await page!.locator('.wb-base-tabs [role="tab"]').count(),3);await settlePanel();}
async function tab(t:string){await page!.locator('.wb-base-tabs [data-tab="'+t+'"]').click();assert.equal(await page!.locator('.wb-base-tabs [data-tab="'+t+'"]').getAttribute('aria-selected'),'true');await settlePanel();}
async function tabsAndDraft(race:string,format:string){
 const before=await snapshot();await open();const row=page!.locator('.wb-facility').first();await row.locator('[data-action="building-enable"]').click();assert.equal(await snapshot(),before);await shot(race+'-'+format+'-placement');
 await tab('technology');assert.equal(await snapshot(),before);await shot(race+'-'+format+'-technology');const icons=await page!.locator('.wb-ui-icon').evaluateAll(els=>els.map(e=>[e.getBoundingClientRect().width,e.getBoundingClientRect().height]));report.checks.push({kind:'icon-geometry',race,format,icons});assert.ok(icons.length&&icons.every(([w,h])=>Math.abs(w-28)<.01&&Math.abs(h-28)<.01));
 const fonts=await page!.locator('.wb-item-heading').evaluateAll(els=>els.map(e=>[getComputedStyle(e.querySelector('strong')!).fontSize,getComputedStyle(e.querySelector('.wb-tech-state,.wb-node-state')!).fontSize]));const scale=await page!.locator('#overlay').evaluate(el=>Number(getComputedStyle(el).getPropertyValue('--ui-layout-scale'))||1);report.checks.push({kind:'physical-text-sizes',race,format,scale,fonts});assert.ok(fonts.every(([name,state])=>Math.abs(parseFloat(name)*scale-14)<.01&&Math.abs(parseFloat(state)*scale-12)<.01));
 await tab('production');assert.equal(await snapshot(),before);await shot(race+'-'+format+'-tree');await page!.locator('.modal-content').last().evaluate(el=>el.scrollTop=el.scrollHeight);assert.equal(await page!.locator('.modal-content').last().evaluate(el=>el.scrollWidth>el.clientWidth+1),false);
 await page!.locator('.wb-base-tabs [data-tab="production"]').focus();await page!.keyboard.press('Home');assert.equal(await page!.locator('.wb-base-tabs [data-tab="facilities"]').getAttribute('aria-selected'),'true');assert.equal(await row.locator('[data-action="building-enable"]').getAttribute('aria-pressed'),'false');await page!.keyboard.press('ArrowRight');assert.equal(await page!.locator('.wb-base-tabs [data-tab="technology"]').getAttribute('aria-selected'),'true');await page!.keyboard.press('End');assert.equal(await page!.locator('.wb-base-tabs [data-tab="production"]').getAttribute('aria-selected'),'true');
 await page!.keyboard.press('Escape');assert.equal(await snapshot(),before);assert.equal(await page!.locator('.feedback-progress-strip [data-action="battle-base"]').evaluate(el=>el===document.activeElement),true);
 report.checks.push({kind:'shared-tabs-draft-cancel-keyboard',race,format,readOnly:true,icons:icons.length,fonts:fonts.length});
}
try{
 for(const [race,project,line] of [['terran','factory','factory'],['zerg','hatchery','zerg.basic'],['protoss','crystal','gateway']].filter(([race])=>!process.argv.includes('--zerg-only')||race==='zerg')){
  const context=await browser.newContext({viewport:{width:1440,height:900},hasTouch:true});await context.addInitScript('window.__name=(value)=>value;');page=await context.newPage();page.setDefaultTimeout(120000);page.on('pageerror',e=>report.errors.push({race,error:e.message}));page.on('console',m=>{if(m.type()==='error')report.consoleErrors.push({race,error:m.text()});});page.on('response',r=>{if(r.status()>=400)report.httpErrors.push({race,url:r.url(),status:r.status()});});
  await start(race);await shot(race+'-native-opening');await fixtureWindow(project,true);
  assert.equal(await page.locator('.feedback-progress-strip [data-action]').count(),3);assert.equal(await page.locator('.feedback-progress-strip [data-action="battle-research"]').count(),0);
  if(race==='terran'){await direction('starport');assert.equal(await page.locator('.wb-prerequisite-card').count(),1);assert.equal(await page.locator('.im-card-action').count(),0);await shot('terran-starport-prerequisite');}
  await direction(line);const free=await state();assert.equal(free.refresh,0);await page.locator('.reward-actions [data-action="reroll"]').click();const first=await state();assert.deepEqual(first.wallet,free.wallet);assert.equal(first.paidRefresh,0);assert.equal(first.refresh,50);await page.locator('.reward-actions [data-action="reroll"]').click();const second=await state();assert.equal(second.wallet.minerals,first.wallet.minerals-50);assert.equal(second.refresh,90);assert.equal(second.paidRefresh,1);report.checks.push({kind:'base-free-and-shared-paid-refresh',race,free,first,second});
  await shot(race+'-desktop-building');await tabsAndDraft(race,'desktop');await page.setViewportSize({width:390,height:844});await shot(race+'-portrait-building');await tabsAndDraft(race,'portrait');
  await open();await page.locator('.wb-facility [data-action="building-enable"]').first().click();await page.locator('[data-action="building-panel-apply"]').click();assert.equal((await state()).groups[0].enabled,false);
  await page.setViewportSize({width:1440,height:900});await purchase(project);await shot(race+'-paid-shop');assert.equal((await state()).refresh,90);
  await open();await shot(race+'-new-facility-placement');await page.keyboard.press('Escape');await nextBattle();await shot(race+'-native-next-front');
  if(race==='zerg'){
   await fixtureWindow('unlock.roach');await direction('zerg.basic');await purchase('unlock.roach');await nextBattle();
   await fixtureWindow('evolve-zerg.evolution');await direction('zerg.evolution');await purchase('evolve-zerg.evolution',2);let s=await state();assert.deepEqual(s.groups.map((g:any)=>g.directions),[[],['ground']]);assert.equal(s.tech['unlock.hydralisk'],1);
   await open();await page.locator('.wb-facility[data-facility="h2"] [data-action="building-output"][data-family="hydralisk"]').click();await page.locator('[data-action="building-panel-apply"]').click();const groundOutputs=(await state()).groups[1].outputs;await nextBattle();
   await fixtureWindow('evolve-zerg.air');await direction('zerg.air');await purchase('evolve-zerg.air',2);s=await state();assert.deepEqual(s.groups[1].directions,['ground','air']);assert.deepEqual(s.groups[1].outputs,groundOutputs);assert.equal(s.tech['unlock.mutalisk'],1);
   await open();await page.locator('.wb-facility[data-facility="h2"] [data-action="building-output"][data-family="zergling"]').click();await page.locator('.wb-facility[data-facility="h2"] [data-action="building-output"][data-family="mutalisk"]').click();await page.locator('[data-action="building-panel-apply"]').click();s=await state();assert.deepEqual(s.groups[1].outputs,['hydralisk','mutalisk']);assert.deepEqual(s.groups[0].outputs,['zergling']);await open();await shot('zerg-dual-direction-placement');await page.setViewportSize({width:390,height:844});await shot('zerg-dual-direction-portrait');await page.keyboard.press('Escape');report.checks.push({kind:'two-directions-local-target-shared-unlocks',state:s});
  }
  report.races.push({race,final:await state(),runtime:await page.evaluate(()=>(window as any).__SC2_REPORT__())});console.log(race+' main controls passed');await context.close();page=undefined;
 }
 assert.deepEqual(report.errors,[]);assert.deepEqual(report.httpErrors,[]);assert.deepEqual(report.consoleErrors,[]);report.passed=true;
}catch(error){report.passed=false;report.failure=String((error as Error).stack??error);if(page)await shot('failure').catch(()=>{});process.exitCode=1;}
finally{report.finishedAt=new Date().toISOString();await fs.writeFile(out+'/result.json',JSON.stringify(report,null,2));await browser.close();await new Promise<void>(resolve=>server.close(()=>resolve()));console.log(JSON.stringify({passed:report.passed,races:report.races.length,checks:report.checks.length,screens:report.screens.length,error:report.failure}));}
